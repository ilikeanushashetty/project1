---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import DeltaMap from '@/components/DeltaMap.astro';
import Icon from '@/components/Icon.astro';
import { site, img, stays, faqs } from '@/data/site';
---

<Base title="Contact & Booking" description="Book a stay at Tierra Resort & Villas, Hejamadi. Call, WhatsApp or send an enquiry.">
  <PageHero eyebrow="Contact" title="Let's plan your <em>escape</em>" image={img.tent} alt="Riverside tent at Tierra"
    intro="Tell us your dates and we'll get back within a day. For quick answers, call or WhatsApp us." />

  <section id="book" class="scroll-mt-24 py-[clamp(4rem,8vw,7rem)]">
    <div class="container-x grid gap-16 lg:grid-cols-12">
      <!-- form -->
      <div class="lg:col-span-7">
        <p class="eyebrow mb-4 text-clay" data-fade>Booking enquiry</p>
        <h2 class="mb-10 text-[clamp(2.4rem,4.5vw,4rem)]" data-split>Send us a <em>note</em></h2>

        <form id="enquiry" class="grid gap-x-6 gap-y-8 sm:grid-cols-2" novalidate data-fade>
          <label class="field"><span>Full name *</span><input name="name" required autocomplete="name" /></label>
          <label class="field"><span>Phone *</span><input name="phone" type="tel" required autocomplete="tel" inputmode="tel" /></label>
          <label class="field sm:col-span-2"><span>Email *</span><input name="email" type="email" required autocomplete="email" /></label>
          <label class="field"><span>Check-in</span><input name="check_in" type="date" /></label>
          <label class="field"><span>Check-out</span><input name="check_out" type="date" /></label>
          <label class="field"><span>Stay</span>
            <select name="stay">
              <option value="">Not sure yet</option>
              {stays.map((s) => <option>{s.name}</option>)}
              <option>Corporate day-out</option>
              <option>Event / celebration</option>
            </select>
          </label>
          <label class="field"><span>Guests</span><input name="guests" type="number" min="1" max="200" value="2" /></label>
          <label class="field sm:col-span-2"><span>Message</span><textarea name="message" rows="4"></textarea></label>
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

          <div class="flex flex-wrap items-center gap-5 sm:col-span-2">
            <button type="submit" class="btn btn-fill"><span data-label>Send enquiry</span> <Icon name="arrow" class="size-4" /></button>
            <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>

      <!-- details -->
      <aside class="space-y-10 lg:col-span-4 lg:col-start-9" data-stagger>
        <div data-fade>
          <p class="eyebrow mb-3 text-clay">Call</p>
          <a href={site.phoneHref} class="block font-display text-3xl link-u">{site.phone}</a>
          <a href={site.phoneAltHref} class="mt-1 block font-display text-3xl link-u">{site.phoneAlt}</a>
        </div>
        <div data-fade>
          <p class="eyebrow mb-3 text-clay">Write</p>
          <a href={`mailto:${site.email}`} class="break-all text-lg link-u">{site.email}</a>
        </div>
        <div data-fade>
          <p class="eyebrow mb-3 text-clay">Visit</p>
          <address class="not-italic leading-relaxed text-ink/75">{site.address.map((l) => <>{l}<br /></>)}</address>
          <a href={site.mapsUrl} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-forest link-u">Open in Google Maps <Icon name="arrow" class="size-4" /></a>
        </div>
        <div data-fade>
          <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="btn btn-line on-light">Chat on WhatsApp</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- map -->
  <section class="bg-sand/60 py-[clamp(4rem,8vw,7rem)]">
    <div class="container-x grid items-center gap-10 lg:grid-cols-2">
      <div class="mx-auto w-full max-w-[520px] bg-paper p-4 md:p-6" data-fade><DeltaMap class="h-auto w-full" /></div>
      <div class="aspect-[4/3] w-full overflow-hidden bg-paper" data-fade>
        <iframe title="Tierra on Google Maps" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="h-full w-full border-0 grayscale-[30%]"
          src={`https://www.google.com/maps?q=${site.geo.lat},${site.geo.lng}&z=14&output=embed`}></iframe>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-[clamp(4rem,8vw,7rem)]">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow mb-4 text-clay" data-fade>Good to know</p>
        <h2 class="text-[clamp(2.4rem,4.5vw,4rem)]" data-split>Questions, <em>answered</em></h2>
      </div>
      <div class="divide-y divide-ink/10 border-y border-ink/10 lg:col-span-7 lg:col-start-6">
        {faqs.map((f, i) => (
          <div class="faq">
            <h3>
              <button class="flex w-full items-center justify-between gap-6 py-6 text-left font-display text-2xl md:text-[1.7rem]" aria-expanded="false" aria-controls={`faq-${i}`}>
                {f.q}
                <span class="faq-icon grid size-9 shrink-0 place-items-center rounded-full border border-ink/20 transition-transform duration-500"><Icon name="plus" class="size-4" /></span>
              </button>
            </h3>
            <div id={`faq-${i}`} class="faq-body grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-[var(--ease-out-expo)]">
              <div class="overflow-hidden"><p class="max-w-xl pb-6 leading-relaxed text-ink/70">{f.a}</p></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .field { display: flex; flex-direction: column; gap: 0.5rem; }
  .field > span { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: color-mix(in oklab, var(--color-ink) 60%, transparent); }
  .field input, .field select, .field textarea {
    width: 100%; background: transparent; border: 0; border-bottom: 1px solid color-mix(in oklab, var(--color-ink) 25%, transparent);
    padding: 0.6rem 0; font-size: 1.05rem; color: var(--color-ink); border-radius: 0; transition: border-color 0.4s;
  }
  .field textarea { resize: vertical; }
  .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--color-forest); }
  .field.invalid input { border-color: var(--color-clay); }
  .faq.open .faq-body { grid-template-rows: 1fr; }
  .faq.open .faq-icon { transform: rotate(45deg); background: var(--color-forest); color: var(--color-paper); border-color: var(--color-forest); }
</style>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  /* FAQ accordion */
  document.querySelectorAll<HTMLElement>('.faq').forEach((faq) => {
    const btn = faq.querySelector('button')!;
    btn.addEventListener('click', () => {
      const open = !faq.classList.contains('open');
      faq.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
      setTimeout(() => ScrollTrigger.refresh(), 520);
    });
  });

  /* Enquiry form -> email via FormSubmit (https://formsubmit.co).
     The first real submission sends an activation email to the inbox below;
     click the link in it once and enquiries start arriving. */
  const FORM_EMAIL = 'tierraresortandvillas@gmail.com';
  const WHATSAPP = '919986988887';

  const form = document.getElementById('enquiry') as HTMLFormElement;
  const status = document.getElementById('form-status')!;
  const label = form.querySelector<HTMLElement>('[data-label]')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

  // preselect stay from ?stay= (links on the Stays page)
  const preset = new URLSearchParams(location.search).get('stay');
  if (preset) (form.elements.namedItem('stay') as HTMLSelectElement).value = preset;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    let ok = true;
    form.querySelectorAll<HTMLInputElement>('[required]').forEach((el) => {
      const bad = !el.checkValidity();
      el.closest('.field')?.classList.toggle('invalid', bad);
      if (bad && ok) { el.focus(); ok = false; }
    });
    if (!ok) { status.textContent = 'Please fill in the highlighted fields.'; status.className = 'text-sm text-clay'; return; }

    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (data._honey) return;
    delete data._honey;

    submit.disabled = true;
    label.textContent = 'Sending…';
    status.textContent = '';
    try {
      const res = await fetch(`https://formsubmit.co/ajax/${FORM_EMAIL}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          ...data,
          _subject: `New booking enquiry${data.stay ? ': ' + data.stay : ''}`,
          _replyto: data.email,
          _template: 'table',
          _captcha: 'false',
        }),
      });
      const json = await res.json();
      if (!res.ok || String(json.success) !== 'true') throw new Error(json.message);
      form.reset();
      status.textContent = "Thank you! We'll be in touch within 24 hours.";
      status.className = 'text-sm text-forest';
    } catch {
      const text = `Hi! I'm ${data.name}. ${data.stay ? 'Stay: ' + data.stay + '. ' : ''}${data.check_in ? 'Dates: ' + data.check_in + ' to ' + data.check_out + '. ' : ''}${data.message || ''} Phone: ${data.phone}`;
      status.innerHTML = `Couldn't send right now. <a class="underline" target="_blank" rel="noopener" href="https://wa.me/${WHATSAPP}?text=${encodeURIComponent(text)}">Send it on WhatsApp instead</a>.`;
      status.className = 'text-sm text-clay';
    } finally {
      submit.disabled = false;
      label.textContent = 'Send enquiry';
    }
  });
</script>
