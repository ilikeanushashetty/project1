---
import Base from '@/layouts/Base.astro';
import Botanical from '@/components/Botanical.astro';
import Icon from '@/components/Icon.astro';
---

<Base title="Page not found" headerTheme="dark">
  <section class="relative flex min-h-[90svh] items-center overflow-hidden pt-24">
    <Botanical class="pointer-events-none absolute -right-10 bottom-0 w-[280px] text-forest/15 md:w-[400px]" />
    <div class="container-x">
      <p class="eyebrow mb-6 text-clay">404</p>
      <h1 class="max-w-3xl text-[clamp(3rem,8vw,7rem)]" data-split>This path leads back to <em>the river</em></h1>
      <p class="mt-6 max-w-md text-ink/70">The page you were looking for has drifted away.</p>
      <a href="/" class="btn btn-fill mt-10">Back home <Icon name="arrow" class="size-4" /></a>
    </div>
  </section>
</Base>
