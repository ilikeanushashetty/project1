---
import Base from '@/layouts/Base.astro';
import AwaitsBento from '@/components/AwaitsBento.astro';
import VideoHero from '@/components/VideoHero.astro';
import Photo from '@/components/Photo.astro';
import ReviewMarquee from '@/components/ReviewMarquee.astro';
import CategoryBand from '@/components/CategoryBand.astro';
import Icon from '@/components/Icon.astro';
import { site, img, essentials, reviews, reviewSummary, faqs, waLink, homeStay, homeDining, homeActivities, homeEvents, stays } from '@/data/site';

// Good to know: the answers people look for before booking
const goodToKnow = faqs.filter((f) => /meals|check-in|pet|parking|WiFi|transport/i.test(f.q));
---

<Base>
  <!-- ============ HERO: the resort fills the screen, the promise, and booking right there ============ -->
  <section data-hero class="relative -mt-[var(--hh)] flex h-[100svh] min-h-[560px] flex-col overflow-hidden bg-night text-paper">
    <div class="absolute inset-0" data-hero-media>
      <Photo src={img.resortPool} alt="Tierra at dusk: the row of A-frame cottages, the lit pool and the palm gardens" priority sizes="100vw" class="h-full" imgClass="object-[50%_50%] max-md:object-[58%_50%]" />
    </div>
    <!-- an even, calm shade over the whole photo, a little deeper at the top for the header -->
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(16_24_28/0.55)_0%,rgb(16_24_28/0.38)_22%,rgb(16_24_28/0.38)_100%)]"></div>

    <!-- just the photo and the promise: nothing else on the first screen -->
    <div class="container-x relative z-[3] flex flex-1 flex-col items-center justify-center pt-[var(--hh)] text-center">
      <p class="text-[clamp(0.8rem,1.1vw,0.95rem)] font-semibold tracking-[0.2em] text-white uppercase" data-fade>Where the river meets the sea</p>
      <!-- what Tierra is, in plain words: two lines at every width (each keeps together, the type scales) -->
      <h1 class="mt-5 text-[clamp(1.5rem,8.6vw,5rem)] leading-[1.05] font-medium text-white" data-split>
        <span class="block whitespace-nowrap">Luxury Beach Resort</span>
        <span class="block whitespace-nowrap">&amp; Campsite</span>
      </h1>
      <a href="#plan" class="btn btn-line mt-10 !px-9" data-fade>Discover Tierra</a>
    </div>

  </section>

  <!-- ============ WELCOME + CHECK AVAILABILITY (second screen) ============ -->
  <section id="plan" class="scroll-mt-20 bg-[#fbf8f2] py-[clamp(3.5rem,7vw,6rem)]">
    <div class="container-x">
      <p class="mx-auto max-w-3xl text-center text-[clamp(1.08rem,1.5vw,1.3rem)] leading-[1.75] text-ink" data-fade>
        Tierra is a luxury beach resort and campsite at Hejamady, on the delta where the backwaters flow into the Arabian Sea. Stay in an A-frame cottage or a luxury room among palm gardens, swim in the pool, and walk to the beach in two minutes.
      </p>
      <div class="mt-[clamp(2.5rem,5vw,3.5rem)]" data-fade>
      <form class="avail grid grid-cols-2 items-stretch lg:grid-cols-[1fr_1fr_0.8fr_1.2fr_auto]" data-avail>
        <label class="avail-field"><span>Check-in</span><input type="date" name="checkin" /></label>
        <label class="avail-field"><span>Check-out</span><input type="date" name="checkout" /></label>
        <label class="avail-field"><span>Guests</span>
          <select name="guests">{['1', '2', '3', '4', '5', '6', '8', '10+'].map((g) => <option value={g} selected={g === '2'}>{g} {g === '1' ? 'guest' : 'guests'}</option>)}</select>
        </label>
        <label class="avail-field"><span>Looking for</span>
          <select name="stay"><option value="">Any stay</option>{stays.map((st) => <option value={st.slug}>{st.name}</option>)}</select>
        </label>
        <button type="submit" class="btn btn-fill col-span-2 m-2 justify-center !px-7 lg:col-span-1">Check availability <Icon name="arrow" class="size-4" /></button>
      </form>
      <p class="mt-3 text-center text-[0.9rem] text-ink-muted">Breakfast included · We reply within the hour</p>
      </div>
    </div>
  </section>

  <!-- ============ WHAT AWAITS YOU ============ -->
  <section class="relative">
    <AwaitsBento items={essentials} eyebrow="What Awaits You" title="Everything for a Perfect Escape"
      text="A nature and beachside campsite resort in Hejamady, between Udupi and Mangalore, where the backwaters meet the Arabian Sea."
      cta={{ label: 'Book Your Stay', href: '/contact#enquire', book: '' }} link={{ label: 'Discover our story', href: '/about' }} />
  </section>

  <!-- ============ STAY / DINING / EXPERIENCES / EVENTS (text + labelled photo tiles) ============ -->
  <CategoryBand eyebrow="Stay" tight title="Your Sanctuaries"
    text="Cool, air-conditioned A-frame cottages, semi A-frames and luxury rooms, each with its own private sit-out looking over the pool and the backwaters."
    tiles={homeStay} cta={{ label: 'View Stays', href: '/accommodation' }} />
  <CategoryBand eyebrow="Dining & Amenities" title="The Coastal Table" tone="champagne" reverse
    text="Mornings start with breakfast on the lawn, on us. Later, our chef cooks to order: the day's catch, coastal Karnataka classics and favourites from further afield, served by the pool or under the palms."
    tiles={homeDining} cta={{ label: 'Explore Amenities', href: '/experiences#dining' }} />
  <CategoryBand eyebrow="Experiences" title="Sea, River <em>&amp; Sky</em>"
    text="Greet the sun with yoga by the water. Paddle the backwaters, catch a wave 200 m away, then let the day end around a crackling fire beneath the stars."
    tiles={homeActivities} cta={{ label: 'All Experiences', href: '/experiences' }} />
  <CategoryBand eyebrow="Weddings & Events" title="Celebrations, Shaped by the Tide" tone="champagne" reverse
    text="Say your vows on palm-lined lawns, gather your team by the water, or mark a milestone at golden hour. Between the backwaters and the sea, every detail is quietly taken care of."
    tiles={homeEvents} cta={{ label: 'Plan Your Event', href: '/contact#enquire', book: 'event' }} />

  <!-- ============ GUEST REVIEWS (real Google reviews, drifting boxes) ============ -->
  <section class="reviews relative overflow-hidden bg-[#fdf7f2] pt-[clamp(3.5rem,7vw,5.5rem)] pb-[clamp(2.5rem,5vw,4rem)]">
    <div class="container-x relative mb-10 text-center">
      <h2 data-split>In Our Guests' Words</h2>
    </div>
    <ReviewMarquee reviews={reviews} rating={reviewSummary.rating} count={reviewSummary.count} url={reviewSummary.url} />
  </section>

  <!-- ============ LOCATION ============ -->
  <section class="relative flex min-h-[64vh] items-center overflow-hidden bg-night text-paper">
    <!-- second video loop, loaded only when the visitor scrolls near it -->
    <VideoHero poster={img.outroPoster} alt="Tierra from above, between the backwaters and the palms"
      desktop="/videos/outro-720.mp4" mobile="/videos/outro-720.mp4" lazy overlay="rgb(22 32 38 / 0.62)" />
    <div class="container-x relative z-[3] py-24 text-center">
      <!-- framed white title + tracked tagline (same language as the hero badge) -->
      <h2 class="retreat-box mx-auto inline-block border border-white px-[clamp(1.1rem,2vw,1.8rem)] py-[clamp(0.9rem,1.6vw,1.4rem)] text-white uppercase" data-fade>
        <span class="block leading-[1] tracking-[0.12em] [margin-right:-0.12em]">Find Your Way</span>
        <span class="mt-1 block leading-[1] tracking-[0.12em] [margin-right:-0.12em]">to the Delta</span>
      </h2>
      <p class="mx-auto mt-7 max-w-3xl font-sans text-[clamp(0.8rem,0.95vw,0.9rem)] leading-[2] font-medium tracking-[0.2em] text-white uppercase" data-fade>Hejamady, on the coastal delta between Udupi and Mangalore</p>
      <ul class="mx-auto mt-8 grid max-w-4xl grid-cols-2 gap-px border border-white/25 bg-white/25 text-white md:grid-cols-5" data-fade>
        {[['Beach', '2 min walk'], ['Surf Club', '200 m'], ['Blue Flag Beach', '3 km'], ['Mangalore', '29 km'], ['Udupi', '30 km']].map(([k, v]) => (
          <li class="bg-[rgb(16_24_28/0.55)] px-4 py-4 backdrop-blur-sm"><span class="block font-display text-2xl">{v}</span><span class="mt-1 block text-[0.75rem] font-semibold tracking-[0.12em] uppercase opacity-85">{k}</span></li>
        ))}
      </ul>
      <div class="mt-10 flex flex-wrap justify-center gap-3" data-fade>
        <a href="/contact#enquire" data-book="" class="btn btn-lime">Reserve <Icon name="arrow" class="size-4" /></a>
        <a href={site.mapsUrl} target="_blank" rel="noopener" class="btn btn-line">Get Directions</a>
      </div>
    </div>
  </section>

  <!-- ============ GOOD TO KNOW ============ -->
  <section class="py-[clamp(3rem,6vw,5rem)]">
    <div class="container-x grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 data-split>Before You Arrive</h2>
        <p class="mt-4 max-w-sm leading-relaxed text-ink/75" data-fade>Check-in from 2 PM, check-out by 11 AM, breakfast included. Anything else, just ask.</p>
        <a href="/faq" class="link-u mt-6 inline-block text-sm font-semibold tracking-[0.12em] text-teal uppercase">All questions →</a>
      </div>
      <div class="divide-y divide-ink/10 border-y border-ink/10 lg:col-span-8">
        {goodToKnow.map((f) => (
          <details class="gtk group">
            <summary class="flex cursor-pointer items-center justify-between gap-6 py-5 font-display text-[1.12rem] text-ink">{f.q}<Icon name="plus" class="size-5 shrink-0 text-teal transition-transform duration-300 group-open:rotate-45" /></summary>
            <p class="pb-6 leading-relaxed text-ink/75">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ RESERVE: the strongest call to action on the page ============ -->
  <section id="reserve" class="scroll-mt-28 border-t border-gold/40 bg-champagne py-[clamp(4rem,8vw,6.5rem)] text-center text-ink">
    <div class="container-x">
      <h2 data-split>The Tide Is Calling</h2>
      <p class="mx-auto mt-4 max-w-xl leading-relaxed text-ink/75" data-fade>Tell us your dates and we'll take care of the rest. WhatsApp is quickest, but we're always happy to talk.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3" data-fade>
        <a href={waLink()} target="_blank" rel="noopener" class="btn btn-fill"><Icon name="whatsapp" class="size-4" /> Message us on WhatsApp</a>
        <a href="/contact#enquire" data-book="" class="btn btn-line on-light">Send an enquiry</a>
        <a href={site.phoneHref} class="btn btn-line on-light">Call {site.phone}</a>
      </div>
      <p class="mt-6 text-[0.88rem] text-ink-muted" data-fade>Breakfast included · We reply within the hour</p>
    </div>
  </section>
</Base>

<style>
  .gtk summary { list-style: none; }
  .gtk summary::-webkit-details-marker { display: none; }
  @keyframes scrollcue { 0% { transform: translateY(-100%); } 100% { transform: translateY(200%); } }

  /* ---- availability bar (second screen): square Sand panel with a hairline ---- */
  .avail { border-radius: 2px; background: var(--color-sand); border: 1px solid rgb(217 196 154 / 0.6); color: var(--color-ink); }
  .avail-field { display: flex; flex-direction: column; justify-content: center; gap: 0.25rem; padding: 0.85rem 1.4rem; border-right: 1px solid rgb(34 48 46 / 0.1); border-bottom: 1px solid rgb(34 48 46 / 0.1); }
  @media (min-width: 1024px) { .avail-field { border-bottom: 0; } }
  .avail-field span { font-size: 0.76rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-gold-deep); }
  .avail-field :is(input, select) { width: 100%; background: transparent; border: 0; padding: 0; font-size: 0.95rem; color: var(--color-ink); }
  .avail-field :is(input, select):focus { outline: none; }
  .avail-field:focus-within { background: rgb(255 255 255 / 0.6); }
  /* the bar rises in after the headline (it sits too low for a scroll trigger) */
</style>

<script>
  // hero bar -> booking box, with the dates already filled in
  document.querySelectorAll<HTMLFormElement>('[data-avail]').forEach((f) => {
    const ci = f.elements.namedItem('checkin') as HTMLInputElement;
    const co = f.elements.namedItem('checkout') as HTMLInputElement;
    const iso = (d: Date) => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    ci.min = iso(new Date());
    ci.addEventListener('change', () => { const n = new Date(ci.value); n.setDate(n.getDate() + 1); co.min = iso(n); if (!co.value || co.value <= ci.value) co.value = iso(n); });
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = Object.fromEntries(new FormData(f)) as Record<string, string>;
      dispatchEvent(new CustomEvent('book:open', { detail: { checkin: d.checkin, checkout: d.checkout, guests: d.guests, stay: d.stay || undefined } }));
    });
  });
</script>
