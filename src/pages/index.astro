---
import Base from '@/layouts/Base.astro';
import AwaitsBento from '@/components/AwaitsBento.astro';
import VideoHero from '@/components/VideoHero.astro';
import ReviewMarquee from '@/components/ReviewMarquee.astro';
import Shoreline from '@/components/Shoreline.astro';
import CategoryBand from '@/components/CategoryBand.astro';
import Icon from '@/components/Icon.astro';
import { site, img, essentials, reviews, reviewSummary, faqs, waLink, homeStay, homeDining, homeActivities, homeEvents } from '@/data/site';

// Good to know: the answers people look for before booking
const goodToKnow = faqs.filter((f) => /meals|check-in|pet|parking|WiFi|transport/i.test(f.q));
---

<Base>
  <!-- ============ HERO ============ -->
  <section data-hero class="relative h-[calc(100svh-var(--hh))] min-h-[560px] overflow-hidden bg-night text-paper">
    <!-- video shown almost untouched: shade only at the top (nav) and bottom (badge) -->
    <VideoHero poster={img.heroPoster} alt="Aerial view of Tierra's A-frame cottages, pool and palms beside the backwaters"
      desktop="/videos/hero-1080.mp4" mobile="/videos/hero-720.mp4" priority
      overlay="linear-gradient(180deg,rgb(16 24 28/0.35) 0%,rgb(16 24 28/0.12) 30%,rgb(16 24 28/0.28) 55%,rgb(16 24 28/0.1) 80%,rgb(16 24 28/0.4) 100%)" />

    <!-- small framed badge + tracked tagline, just below the middle -->
    <div class="absolute inset-x-0 top-[60%] z-[3] flex -translate-y-1/2 flex-col items-center px-5 text-center">
      <div class="wordmark relative">
        <!-- border draws itself in -->
        <svg class="wordmark-frame pointer-events-none absolute inset-0 h-full w-full overflow-visible" aria-hidden="true">
          <rect x="0.5" y="0.5" width="100%" height="100%" pathLength="1" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" style="width:calc(100% - 1px);height:calc(100% - 1px)" />
        </svg>
        <!-- small bird perched on the frame, after the bird on the line in the Tierra logo -->
        <svg class="wordmark-bird absolute top-0 right-[14%] w-[clamp(18px,1.7vw,26px)] -translate-y-[86%]" viewBox="0 0 40 40" aria-hidden="true">
          <path d="M9 30 L14 25.5 C 12.5 19 18 13.5 25 14.5 C 27.5 10.5 33 10.5 35 14 L 39 14.8 L 35.2 16.6 C 35 23.5 29 28.5 21.5 28.2 Z" fill="var(--color-leaf)" />
          <path d="M17 22.5 C 21 19.2 26.5 19.2 29.5 21.4 C 26.5 25.4 20.6 26.2 17 22.5 Z" fill="#5e9a2e" />
          <circle cx="31.6" cy="14.4" r="1.15" fill="var(--color-mangrove)" />
          <path d="M22 28 L21 39.5 M25 27.6 L25.5 39.5" stroke="var(--color-shell)" stroke-width="1.1" stroke-linecap="round" />
        </svg>
        <h1 class="px-[clamp(0.9rem,1.3vw,1.3rem)] py-[clamp(0.7rem,1.1vw,1.05rem)] font-normal tracking-normal normal-case">
          <span class="wm-line block text-[clamp(1.75rem,2.9vw,2.75rem)] leading-[0.95] tracking-[0.14em] uppercase [margin-right:-0.14em]">Tierra</span>
          <span class="wm-line block text-[clamp(1.16rem,1.92vw,1.82rem)] leading-[1.05] tracking-[0.16em] uppercase [margin-right:-0.16em]">Campsite</span>
        </h1>
      </div>
      <p class="tagline mt-[clamp(1.1rem,2.4vh,1.8rem)] font-sans text-[clamp(0.7rem,0.95vw,0.88rem)] leading-[1.9] font-medium text-paper uppercase">
        Where River Meets Sea, <br class="sm:hidden" />Luxury Finds Its Home
      </p>
    </div>

  </section>

  <!-- ============ WHAT AWAITS YOU (straight after the video) ============ -->
  <section class="relative">
    <AwaitsBento items={essentials} eyebrow="What Awaits You" title="Everything for a Perfect Escape"
      text="A nature and beachside campsite resort in Hejamady, between Udupi and Mangalore, where the backwaters meet the Arabian Sea."
      cta={{ label: 'Book Your Stay', href: '/contact#enquire', book: '' }} link={{ label: 'Discover our story', href: '/about' }} />
  </section>

  <!-- ============ STAY / DINING / EXPERIENCES / EVENTS (text + labelled photo tiles) ============ -->
  <CategoryBand eyebrow="Stay" tight title="Campsite <em>Villas</em>"
    text="Air-conditioned A-frame cottages, semi A-frames and luxury rooms, each with a private sit-out and views of the pool and backwaters."
    tiles={homeStay} cta={{ label: 'View Stays', href: '/accommodation' }} />
  <CategoryBand eyebrow="Dining & Amenities" title="Café &amp; <em>Coastal Kitchen</em>" tone="champagne" reverse
    text="Breakfast is included. Lunch and dinner are made to order by our in-house chef: fresh seafood, coastal favourites and cuisines from everywhere, served by the pool or on the lawn."
    tiles={homeDining} cta={{ label: 'Explore Amenities', href: '/experiences#dining' }} />
  <CategoryBand eyebrow="Experiences" title="Sea, River <em>&amp; Sky</em>"
    text="Morning yoga by the water, surfing at the club 200 m away, kayaking the backwaters and campfires under the stars, with the beach just a short walk away."
    tiles={homeActivities} cta={{ label: 'All Experiences', href: '/experiences' }} />
  <CategoryBand eyebrow="Weddings & Events" title="Celebrate <em>by the Sea</em>" tone="champagne" reverse
    text="Destination weddings, birthdays, anniversaries, corporate retreats and photoshoots, set between the backwaters and the Arabian Sea. We take care of every detail."
    tiles={homeEvents} cta={{ label: 'Plan Your Event', href: '/contact#enquire', book: 'event' }} />

  <!-- ============ GUEST REVIEWS (real Google reviews, drifting boxes) ============ -->
  <section class="reviews relative overflow-hidden pt-[clamp(3.5rem,7vw,5.5rem)] pb-[clamp(2.5rem,5vw,4rem)]">
    <!-- animated sea, foam and sand behind the frosted glass cards -->
    <Shoreline />
    <div class="container-x relative mb-8 text-center">
      <h2 data-split>What Our <em>Guests Say</em></h2>
    </div>
    <ReviewMarquee reviews={reviews} rating={reviewSummary.rating} count={reviewSummary.count} url={reviewSummary.url} />
  </section>

  <!-- ============ LOCATION ============ -->
  <section class="relative flex min-h-[64vh] items-center overflow-hidden bg-night text-paper">
    <!-- second video loop, loaded only when the visitor scrolls near it -->
    <VideoHero poster={img.outroPoster} alt="Tierra from above, between the backwaters and the palms"
      desktop="/videos/outro-720.mp4" mobile="/videos/outro-720.mp4" lazy overlay="rgb(22 32 38 / 0.62)" />
    <div class="container-x relative z-[3] py-24 text-center">
      <!-- framed white title + tracked tagline (same language as the hero badge) -->
      <h2 class="retreat-box mx-auto inline-block border border-white px-[clamp(1.1rem,2vw,1.8rem)] py-[clamp(0.9rem,1.6vw,1.4rem)] text-white uppercase" data-fade>
        <span class="block leading-[1] tracking-[0.12em] [margin-right:-0.12em]">Your Coastal</span>
        <span class="mt-1 block leading-[1] tracking-[0.12em] [margin-right:-0.12em]">Retreat Awaits</span>
      </h2>
      <p class="mx-auto mt-7 max-w-3xl font-sans text-[clamp(0.8rem,0.95vw,0.9rem)] leading-[2] font-medium tracking-[0.2em] text-white uppercase" data-fade>Hejamady, on the coastal delta between Udupi and Mangalore</p>
      <ul class="mx-auto mt-8 grid max-w-4xl grid-cols-2 gap-px border border-white/25 bg-white/25 text-white md:grid-cols-5" data-fade>
        {[['Beach', '2 min walk'], ['Surf Club', '200 m'], ['Blue Flag Beach', '3 km'], ['Mangalore', '29 km'], ['Udupi', '30 km']].map(([k, v]) => (
          <li class="bg-[rgb(16_24_28/0.55)] px-4 py-4 backdrop-blur-sm"><span class="block font-display text-2xl">{v}</span><span class="mt-1 block text-[0.75rem] font-semibold tracking-[0.12em] uppercase opacity-85">{k}</span></li>
        ))}
      </ul>
      <div class="mt-10 flex flex-wrap justify-center gap-3" data-fade>
        <a href="/contact#enquire" data-book="" class="btn btn-lime">Book Your Stay <Icon name="arrow" class="size-4" /></a>
        <a href={site.mapsUrl} target="_blank" rel="noopener" class="btn btn-line">Get Directions</a>
      </div>
    </div>
  </section>

  <!-- ============ GOOD TO KNOW ============ -->
  <section class="py-[clamp(3rem,6vw,5rem)]">
    <div class="container-x grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 data-split>Good <em>to Know</em></h2>
        <a href="/faq" class="link-u mt-6 inline-block text-sm font-semibold tracking-[0.12em] text-teal uppercase">All questions →</a>
      </div>
      <div class="divide-y divide-ink/10 border-y border-ink/10 lg:col-span-8">
        {goodToKnow.map((f) => (
          <details class="gtk group">
            <summary class="flex cursor-pointer items-center justify-between gap-6 py-5 font-display text-[1.12rem] text-ink">{f.q}<Icon name="plus" class="size-5 shrink-0 text-teal transition-transform duration-300 group-open:rotate-45" /></summary>
            <p class="pb-6 leading-relaxed text-ink/75">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ BOOK ============ -->
  <section class="border-t border-gold/40 bg-champagne py-[clamp(3.5rem,7vw,5.5rem)] text-center text-ink">
    <div class="container-x">
      <h2 data-split>Your Escape <em>Starts Here</em></h2>
      <p class="mx-auto mt-4 max-w-xl text-ink/75" data-fade>Message us on WhatsApp for the quickest reply, send an enquiry, or simply call.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3" data-fade>
        <a href={waLink()} target="_blank" rel="noopener" class="btn btn-fill"><Icon name="whatsapp" class="size-4" /> WhatsApp</a>
        <a href="/contact#enquire" data-book="" class="btn btn-line on-light">Send Enquiry</a>
        <a href={site.phoneHref} class="btn btn-line on-light">Call {site.phone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .gtk summary { list-style: none; }
  .gtk summary::-webkit-details-marker { display: none; }
  @keyframes scrollcue { 0% { transform: translateY(-100%); } 100% { transform: translateY(200%); } }

  /* ---- hero wordmark ---- */
  .wordmark { color: var(--color-shell); }
  .wordmark-frame rect { stroke-dasharray: 1; stroke-dashoffset: 0; opacity: 0.85; }
  .tagline { letter-spacing: 0.2em; text-shadow: 0 1px 18px rgb(16 24 28 / 0.5); }
  @media (min-width: 640px) { .tagline { letter-spacing: 0.32em; } }
  .wordmark h1 { text-shadow: 0 2px 30px rgb(16 24 28 / 0.35); }

  /* entrance sequence: frame draws, words rise, tagline tracks in, bird hops on */
  :global(.js:not(.reduced)) .wordmark-frame rect { stroke-dashoffset: 1; animation: frame-draw 1.8s var(--ease-in-out-quart) 0.3s forwards; }
  :global(.js:not(.reduced)) .wm-line { opacity: 0; transform: translateY(35%); animation: wm-rise 1.4s var(--ease-out-expo) forwards; }
  :global(.js:not(.reduced)) .wm-line:nth-child(1) { animation-delay: 0.9s; }
  :global(.js:not(.reduced)) .wm-line:nth-child(2) { animation-delay: 1.1s; }
  :global(.js:not(.reduced)) .tagline { opacity: 0; animation: track-in 2s var(--ease-out-expo) 1.6s forwards; }
  :global(.js:not(.reduced)) .wordmark-bird { opacity: 0; animation: bird-hop 1s var(--ease-out-expo) 2.4s forwards; }
  :global(.js:not(.reduced)) .scroll-cue { opacity: 0; animation: fade-in 1s ease 2.8s forwards; }

  @keyframes frame-draw { to { stroke-dashoffset: 0; } }
  @keyframes wm-rise { to { opacity: 1; transform: none; } }
  @keyframes track-in { from { opacity: 0; letter-spacing: 0.55em; } to { opacity: 1; letter-spacing: 0.32em; } }
  @keyframes bird-hop {
    0% { opacity: 0; transform: translate(18px, -70%) rotate(-10deg); }
    55% { opacity: 1; transform: translate(0, 8%) rotate(3deg); }
    100% { opacity: 1; transform: none; }
  }
  @keyframes fade-in { to { opacity: 1; } }
  /* small screens: no letter-spacing animation (avoids re-wrapping mid-animation) */
  @media (max-width: 639px) { @keyframes track-in { from { opacity: 0; } to { opacity: 1; } } }
</style>
