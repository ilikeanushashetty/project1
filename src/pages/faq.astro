---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { img, faqs, waLink } from '@/data/site';
---

<Base title="FAQ" description="Frequently asked questions about staying at Tierra Campsite: Blue Flag Beach distance, WiFi, pool, transport, check-in times, pets, parking and air-conditioning.">
  <PageHero eyebrow="Help Center" title="Frequently Asked <em>Questions</em>" image={img.aFrameRow} alt="A-frame cottages at Tierra"
    intro="Find answers to common questions about your stay" />

  <section class="pt-[clamp(2rem,4vw,3rem)] pb-[clamp(4rem,8vw,7rem)]">
    <div class="container-x max-w-4xl">
      <div class="divide-y divide-ink/10 border-y border-ink/10">
        {faqs.map((f, i) => (
          <div class="faq" data-fade>
            <h3>
              <button class="flex w-full items-center justify-between gap-6 py-6 text-left transition-colors hover:text-teal" aria-expanded="false" aria-controls={`faq-${i}`}>
                {f.q}
                <span class="faq-icon grid size-9 shrink-0 place-items-center rounded-[2px] bg-sand text-gold-deep transition-transform duration-500"><Icon name="plus" class="size-4" /></span>
              </button>
            </h3>
            <div id={`faq-${i}`} class="faq-body grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-[var(--ease-out-expo)]">
              <div class="overflow-hidden"><p class="pb-6 leading-relaxed text-ink/75">{f.a}</p></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand eyebrow="Still Have Questions?" title="We'd Love to <em>Hear from You</em>" text="Our team is ready to assist you with any inquiries about your stay at Tierra Campsite."
    actions={[{ label: 'Contact Us', href: '/contact' }, { label: 'WhatsApp Us', href: waLink(), external: true }]} />
</Base>

<style>
  .faq.open .faq-body { grid-template-rows: 1fr; }
  .faq.open .faq-icon { transform: rotate(45deg); background: var(--color-sea); color: #fff; border-color: var(--color-sea); }
</style>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  document.querySelectorAll<HTMLElement>('.faq').forEach((faq) => {
    const btn = faq.querySelector('button')!;
    btn.addEventListener('click', () => {
      const open = !faq.classList.contains('open');
      faq.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
      setTimeout(() => ScrollTrigger.refresh(), 520);
    });
  });
</script>
