---
import Base from '@/layouts/Base.astro';
import Photo from '@/components/Photo.astro';
import Icon from '@/components/Icon.astro';
import { getImage } from 'astro:assets';
import { gallery, galleryCategories } from '@/data/site';

/* Just the photos: a filter bar and a grid (rows of three with a large photo now and then).
   Any photo opens the phone-style gallery at that photo. */
const cats = galleryCategories.filter((c) => gallery.some((g) => g.tag === c));

// phone gallery: square thumbnails + full-size photos
const photos = await Promise.all(
  gallery.map(async (g) => ({
    ...g,
    thumb: (await getImage({ src: g.image, width: 480, height: 480, fit: 'cover', format: 'webp' })).src,
    full: (await getImage({ src: g.image, width: Math.min(1600, g.image.width), format: 'webp' })).src,
  })),
);
---

<Base title="Gallery" headerTheme="dark" description="Explore the beauty of Tierra Campsite through our gallery: the delta point, backwaters, A-frame cottages, pool and evenings by the river.">
  <section class="pt-[clamp(2rem,4vw,3.5rem)] pb-[clamp(3rem,6vw,5rem)]">
    <div class="container-x">
      <h1 class="sr-only">Gallery</h1>

      <!-- filter bar -->
      <div class="g-filters" role="tablist" aria-label="Filter photos">
        {['All', ...cats].map((t, i) => (
          <button type="button" role="tab" class="g-filter" data-filter={t} aria-selected={i === 0 ? 'true' : 'false'}>{t}</button>
        ))}
      </div>

      <!-- photos -->
      <ul class="g-grid mt-[clamp(1rem,2vw,1.5rem)]" data-grid-page>
        {gallery.map((g, i) => (
          <li class="g-item" data-tag={g.tag}>
            <button type="button" class="g-open" data-photo={i} aria-label={`Open photo: ${g.alt}`}>
              <Photo src={g.image} alt={g.alt} sizes="(min-width: 768px) 50vw, 100vw" class="h-full" imgClass={g.focus} priority={i < 3} />
              <span class="g-cap" aria-hidden="true"><span class="block text-[0.78rem] font-semibold tracking-[0.12em] uppercase opacity-85">{g.tag}</span>{g.alt}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ PHONE GALLERY: grid of photos → tap one → swipe through ============ -->
  <dialog id="phone-gallery" class="g-dialog" aria-label="Photo gallery" data-lenis-prevent>
    <div class="g-stage" data-dismiss>
      <div class="g-phone">
        <div class="g-screen">
          <!-- grid view -->
          <div class="g-grid-view" data-grid-view>
            <header class="g-bar">
              <div class="flex items-center justify-between px-4 pt-4">
                <p class="font-display text-[1.7rem] leading-none">Photos</p>
                <button type="button" class="g-close" data-close aria-label="Close gallery"><Icon name="close" class="size-4" /></button>
              </div>
              <div class="g-chips" role="tablist" aria-label="Filter photos">
                {['All', ...cats].map((t) => (
                  <button type="button" role="tab" class="g-chip" data-chip={t} aria-selected="false">{t}</button>
                ))}
              </div>
            </header>
            <ul class="grid grid-cols-3 gap-[2px]" data-grid>
              {photos.map((p, i) => (
                <li data-tag={p.tag}>
                  <button type="button" class="g-thumb" data-thumb={i} aria-label={`Open photo: ${p.alt}`}>
                    <img src={p.thumb} alt="" loading="lazy" decoding="async" width="480" height="480" />
                  </button>
                </li>
              ))}
            </ul>
            <p class="py-6 text-center text-xs font-semibold tracking-[0.12em] text-white/60 uppercase" data-grid-count></p>
          </div>

          <!-- single photo view -->
          <div class="g-viewer" data-viewer aria-hidden="true">
            <div class="flex items-center justify-between px-3 pt-4 pb-2">
              <button type="button" class="g-back" data-back><Icon name="chevron" class="size-4 rotate-90" /> Photos</button>
              <span class="text-xs font-semibold tracking-[0.1em] text-white/70" data-v-count></span>
            </div>
            <div class="g-photo-area" data-photo-area>
              <img class="g-photo" data-photo alt="" />
            </div>
            <div class="px-4 pt-3 pb-5">
              <p class="eyebrow text-gold-light" data-v-tag></p>
              <p class="mt-1 font-display text-xl" data-v-title></p>
              <div class="mt-4 flex justify-between">
                <button type="button" class="g-nav" data-v-prev aria-label="Previous photo"><Icon name="arrow" class="size-4 rotate-180" /></button>
                <button type="button" class="g-nav" data-v-next aria-label="Next photo"><Icon name="arrow" class="size-4" /></button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script type="application/json" data-photos set:html={JSON.stringify(photos.map((p) => ({ full: p.full, alt: p.alt, tag: p.tag })))} />
  </dialog>
</Base>

<style>
  /* filter bar: soft band, gold labels, the chosen one on a white tab */
  .g-filters { display: flex; justify-content: center; background: var(--color-mist); padding: 0 clamp(0.5rem, 2vw, 1.5rem); }
  /* phones: one row that scrolls sideways */
  @media (max-width: 767px) { .g-filters { justify-content: flex-start; overflow-x: auto; scrollbar-width: none; } .g-filter { flex: none; } }
  .g-filter { padding: 1.05rem clamp(0.8rem, 1.6vw, 1.4rem); color: var(--color-gold-deep); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; transition: color 0.3s, background 0.3s; }
  .g-filter:hover { color: var(--color-ink); }
  .g-filter[aria-selected='true'] { background: #fff; color: var(--color-ink); }

  /* grid: three across; every so often one photo takes two columns and two rows */
  .g-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-flow: row dense; gap: clamp(0.5rem, 1.6vw, 1.5rem); }
  @media (min-width: 768px) { .g-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .g-item { aspect-ratio: 6 / 5; min-height: 0; }
  .g-item.is-hidden { display: none; }
  .g-item.is-big { grid-column: 1 / -1; }
  @media (min-width: 768px) {
    .g-item.is-big { aspect-ratio: auto; grid-row: span 2; grid-column: 1 / span 2; }
    .g-item.is-big.is-right { grid-column: 2 / span 2; }
  }
  .g-open { position: relative; display: block; width: 100%; height: 100%; overflow: hidden; cursor: zoom-in; background: var(--color-mist); }
  .g-open :global(img) { transition: transform 1.2s var(--ease-out-expo); }
  .g-open:hover :global(img) { transform: scale(1.05); }
  .g-open:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 3px; }
  /* caption: always on touch screens, slides up on hover elsewhere */
  .g-cap { position: absolute; inset: auto 0 0 0; padding: 2.2rem 1rem 0.9rem; background: linear-gradient(transparent, rgb(7 42 56 / 0.78)); color: #fff; font-family: var(--font-display); font-size: 1.1rem; text-align: left; line-height: 1.25; }
  @media (hover: hover) { .g-cap { opacity: 0; transform: translateY(8px); transition: opacity 0.4s, transform 0.5s var(--ease-out-expo); } .g-open:hover .g-cap, .g-open:focus-visible .g-cap { opacity: 1; transform: none; } }

  /* photos fade up as they come into view */
  :global(.js:not(.reduced)) .g-item { opacity: 0; transform: translateY(28px); transition: opacity 0.9s var(--ease-out-expo), transform 0.9s var(--ease-out-expo); }
  :global(.js:not(.reduced)) .g-item.is-in { opacity: 1; transform: none; }

  /* ---- phone gallery ---- */
  .g-dialog { margin: 0; width: 100%; max-width: none; height: 100%; max-height: none; padding: 0; border: 0; overflow: hidden; background: transparent; color: #fff; }
  .g-dialog::backdrop { background: rgb(7 42 56 / 0.82); backdrop-filter: blur(10px); }
  .g-dialog[open] { animation: g-fade 0.4s ease; }
  .g-dialog[open] .g-phone { animation: g-pop 0.7s var(--ease-out-expo); }
  @keyframes g-fade { from { opacity: 0; } }
  @keyframes g-pop { from { opacity: 0; transform: translateY(40px) scale(0.96); } }
  .g-stage { display: grid; height: 100%; grid-template-columns: minmax(0, 1fr); place-items: center; }
  /* on phones the screen is the phone; on larger screens it sits in a phone frame */
  .g-phone { position: relative; width: 100%; height: 100%; background: #000; }
  @media (min-width: 768px) {
    .g-phone { width: 390px; height: min(820px, calc(100svh - 3rem)); padding: 11px; border-radius: 54px; background: #0b0b0b; box-shadow: 0 0 0 2px #2a2a2a, 0 40px 120px -30px rgb(0 0 0 / 0.8); }
    .g-phone::before { content: ''; position: absolute; top: 22px; left: 50%; z-index: 5; width: 110px; height: 30px; border-radius: 20px; background: #000; transform: translateX(-50%); }
    .g-screen { border-radius: 44px; }
    .g-bar { padding-top: 2.6rem; }
    .g-viewer > :first-child { padding-top: 3.2rem; }
  }
  .g-screen { position: relative; height: 100%; overflow: hidden; background: #000; }
  .g-grid-view { height: 100%; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none; }
  .g-bar { position: sticky; top: 0; z-index: 2; background: rgb(0 0 0 / 0.78); backdrop-filter: blur(14px); }
  .g-close { display: grid; width: 2.1rem; height: 2.1rem; place-items: center; border-radius: 999px; background: rgb(255 255 255 / 0.14); }
  .g-chips { display: flex; gap: 0.4rem; overflow-x: auto; padding: 0.85rem 1rem 0.75rem; scrollbar-width: none; }
  .g-chip { flex: none; padding: 0.4rem 0.85rem; border-radius: 999px; background: rgb(255 255 255 / 0.12); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em; white-space: nowrap; transition: background 0.3s, color 0.3s; }
  .g-chip[aria-selected='true'] { background: var(--color-gold); color: var(--color-ocean-deep); }
  .g-thumb { display: block; width: 100%; aspect-ratio: 1; overflow: hidden; }
  .g-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease-out-expo), opacity 0.3s; }
  .g-thumb:hover img { transform: scale(1.06); }
  .g-thumb:active img { opacity: 0.7; }
  li.is-hidden { display: none; }

  .g-viewer { position: absolute; inset: 0; z-index: 3; display: flex; flex-direction: column; background: #000; transform: translateX(100%); transition: transform 0.55s var(--ease-out-expo); }
  .g-viewer.is-open { transform: none; }
  .g-back { display: inline-flex; align-items: center; gap: 0.15rem; color: var(--color-gold-light); font-size: 0.95rem; font-weight: 600; }
  .g-photo-area { position: relative; flex: 1; min-height: 0; touch-action: pan-y; }
  .g-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity 0.35s, transform 0.45s var(--ease-out-expo); }
  .g-photo.is-swap { opacity: 0; transform: translateX(var(--dir, 30px)); }
  .g-nav { display: grid; width: 2.6rem; height: 2.6rem; place-items: center; border-radius: 999px; background: rgb(255 255 255 / 0.14); transition: background 0.3s, color 0.3s; }
  .g-nav:hover { background: var(--color-gold); color: var(--color-ocean-deep); }

  @media (prefers-reduced-motion: reduce) { .g-viewer, .g-photo { transition: none; } }
</style>

<script>
  const reduced = document.documentElement.classList.contains('reduced') || matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- page grid: filters, large-photo rhythm, fade-in ---- */
  const pageItems = Array.from(document.querySelectorAll<HTMLLIElement>('[data-grid-page] .g-item'));
  const pageFilters = Array.from(document.querySelectorAll<HTMLButtonElement>('.g-filter'));
  let pageTag = 'All';
  const arrange = () => {
    const shown = pageItems.filter((li) => !li.classList.contains('is-hidden'));
    shown.forEach((li, p) => {
      // a large photo at the 4th and 10th place of every twelve, left then right,
      // only when two more photos follow to sit beside it
      const big = (p % 12 === 3 || p % 12 === 9) && p + 2 < shown.length;
      li.classList.toggle('is-big', big);
      li.classList.toggle('is-right', big && p % 12 === 9);
      li.style.transitionDelay = `${(p % 3) * 90}ms`;
    });
  };
  const io = new IntersectionObserver((entries) => entries.forEach((e) => {
    if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
  }), { rootMargin: '0px 0px -8% 0px' });
  pageItems.forEach((li) => io.observe(li));
  pageFilters.forEach((btn) => btn.addEventListener('click', () => {
    pageTag = btn.dataset.filter!;
    pageFilters.forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
    pageItems.forEach((li) => li.classList.toggle('is-hidden', pageTag !== 'All' && li.dataset.tag !== pageTag));
    arrange();
  }));
  arrange();

  /* ---- phone gallery ---- */
  type P = { full: string; alt: string; tag: string };
  const dlg = document.getElementById('phone-gallery') as HTMLDialogElement;
  const data: P[] = JSON.parse(dlg.querySelector('[data-photos]')!.textContent!);
  const items = Array.from(dlg.querySelectorAll<HTMLLIElement>('[data-grid] li'));
  const chips = Array.from(dlg.querySelectorAll<HTMLButtonElement>('[data-chip]'));
  const gridView = dlg.querySelector<HTMLElement>('[data-grid-view]')!;
  const gridCount = dlg.querySelector<HTMLElement>('[data-grid-count]')!;
  const viewer = dlg.querySelector<HTMLElement>('[data-viewer]')!;
  const photo = dlg.querySelector<HTMLImageElement>('[data-photo]')!;
  const vCount = dlg.querySelector<HTMLElement>('[data-v-count]')!;
  const vTag = dlg.querySelector<HTMLElement>('[data-v-tag]')!;
  const vTitle = dlg.querySelector<HTMLElement>('[data-v-title]')!;
  let list: number[] = [];
  let pos = 0;

  const setFilter = (tag: string) => {
    chips.forEach((c) => c.setAttribute('aria-selected', String(c.dataset.chip === tag)));
    list = [];
    items.forEach((li, i) => {
      const show = tag === 'All' || li.dataset.tag === tag;
      li.classList.toggle('is-hidden', !show);
      if (show) list.push(i);
    });
    gridCount.textContent = `${list.length} ${list.length === 1 ? 'Photo' : 'Photos'}`;
    gridView.scrollTop = 0;
  };
  const render = (dir = 0) => {
    const p = data[list[pos]];
    const swap = () => {
      photo.src = p.full;
      photo.alt = p.alt;
      vTag.textContent = p.tag;
      vTitle.textContent = p.alt;
      vCount.textContent = `${pos + 1} of ${list.length}`;
    };
    if (!dir || reduced) { swap(); return; }
    photo.style.setProperty('--dir', `${-dir * 30}px`);
    photo.classList.add('is-swap');
    setTimeout(() => {
      swap();
      photo.style.setProperty('--dir', `${dir * 30}px`);
      requestAnimationFrame(() => photo.classList.remove('is-swap'));
    }, 180);
  };
  const openPhoto = (i: number) => { pos = list.indexOf(i); render(); viewer.classList.add('is-open'); viewer.setAttribute('aria-hidden', 'false'); };
  const closePhoto = () => { viewer.classList.remove('is-open'); viewer.setAttribute('aria-hidden', 'true'); };
  const step = (d: number) => { pos = (pos + d + list.length) % list.length; render(d); };

  const open = (tag: string) => {
    setFilter(tag);
    closePhoto();
    dlg.showModal();
    dispatchEvent(new Event('lenis:stop'));
  };
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) => b.addEventListener('click', () => open(b.dataset.open!)));
  chips.forEach((c) => c.addEventListener('click', () => setFilter(c.dataset.chip!)));
  dlg.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((b) => b.addEventListener('click', () => openPhoto(Number(b.dataset.thumb))));
  dlg.querySelector('[data-back]')!.addEventListener('click', closePhoto);
  dlg.querySelector('[data-v-prev]')!.addEventListener('click', () => step(-1));
  dlg.querySelector('[data-v-next]')!.addEventListener('click', () => step(1));
  dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
  // click outside the phone closes
  dlg.addEventListener('click', (e) => { if ((e.target as HTMLElement).hasAttribute('data-dismiss')) dlg.close(); });
  dlg.addEventListener('close', () => dispatchEvent(new Event('lenis:start')));
  dlg.addEventListener('keydown', (e) => {
    if (!viewer.classList.contains('is-open')) return;
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'Escape') { e.preventDefault(); closePhoto(); }
  });
  // swipe between photos
  const area = dlg.querySelector<HTMLElement>('[data-photo-area]')!;
  let x0: number | null = null;
  area.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
  area.addEventListener('pointerup', (e) => {
    if (x0 === null) return;
    const dx = e.clientX - x0;
    x0 = null;
    if (Math.abs(dx) > 40) step(dx < 0 ? 1 : -1);
  });

  // any photo opens the phone gallery straight at that photo (within the current filter)
  document.querySelectorAll<HTMLButtonElement>('[data-photo]').forEach((b) =>
    b.addEventListener('click', () => { open(pageTag); openPhoto(Number(b.dataset.photo)); }),
  );
</script>
