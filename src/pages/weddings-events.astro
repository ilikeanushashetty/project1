---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import FeatureRow from '@/components/FeatureRow.astro';
import Photo from '@/components/Photo.astro';
import Icon from '@/components/Icon.astro';
import { img, occasions, eventDetails, eventVenues, corporateOffer, site, waLink } from '@/data/site';
---

<Base title="Weddings & Events" description="Destination weddings, celebrations, corporate events and photoshoots at Tierra, Hejamady, where the backwaters meet the Arabian Sea.">
  <PageHero eyebrow="Weddings & Events" title="Celebrate <em>by the Sea</em>" image={img.aboutSunset} alt="Tierra at sunset, the A-frames and pool by the Arabian Sea"
    intro="Destination weddings, celebrations and corporate retreats between the backwaters and the sea." />

  <nav class="sticky top-[var(--hh-now)] transition-[top] duration-500 z-30 border-b border-ink/10 bg-shell/90 backdrop-blur" aria-label="Weddings and events" data-spy>
    <ul class="container-x flex gap-1 overflow-x-auto py-1 text-[0.78rem] font-semibold tracking-[0.12em] uppercase [scrollbar-width:none]">
      {[['weddings', 'Weddings'], ['celebrations', 'Celebrations'], ['corporate', 'Corporate'], ['photoshoots', 'Photoshoots'], ['venues', 'Venues']].map(([id, l]) => (
        <li class="shrink-0"><a href={`#${id}`} class="spy-link relative block px-3 py-3 text-ink/70 transition-colors hover:text-teal">{l}</a></li>
      ))}
    </ul>
  </nav>

  <div class="container-x space-y-[clamp(4rem,8vw,7rem)] py-[clamp(3.5rem,7vw,6rem)]">
    <FeatureRow id="weddings" icon="ring" eyebrow="Destination Weddings" title="Say “I Do” <em>by the Water</em>" image={img.sampleWedding} alt="A wedding ceremony under a floral mandap"
      text="Exchange vows where the backwaters meet the Arabian Sea. Our lawns, poolside and backwater garden set the scene for ceremonies, receptions and sangeet evenings, with stays for family and guests right on site."
      points={['Lawn, poolside & garden venues', 'Stays for guests on site', 'Décor, catering & cakes arranged', 'Sunset ceremonies']}
      book="wedding" bookLabel="Plan Your Wedding" />
  </div>

  <!-- celebrations -->
  <section id="celebrations" class="scroll-mt-40 bg-champagne py-[clamp(3.5rem,7vw,5.5rem)]">
    <div class="container-x">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <h2 data-split>Moments That <em>Deserve More</em></h2>
        </div>
        <p class="leading-relaxed text-ink/75 lg:col-span-5" data-fade>Birthdays, anniversaries, proposals and small gatherings, celebrated with the river as your backdrop and the stars as your ceiling.</p>
      </div>
      <ul class="mt-10 grid gap-px bg-ink/10 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {occasions.map((o) => (
          <li class="bg-champagne p-7" data-fade>
            <Icon name={o.icon} class="size-7 text-teal" />
            <h3 class="mt-5">{o.title}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-ink/70">{o.text}</p>
          </li>
        ))}
      </ul>
      <div class="mt-10 grid gap-x-10 gap-y-4 border-t border-ink/10 pt-8 sm:grid-cols-2 lg:grid-cols-4">
        {eventDetails.map((d) => (
          <p class="flex gap-3"><Icon name={d.icon} class="mt-0.5 size-5 shrink-0 text-gold-deep" /><span><strong class="block font-semibold text-ink">{d.title}</strong><span class="text-sm text-ink/70">{d.text}</span></span></p>
        ))}
      </div>
      <a href="/contact#enquire" data-book="event" class="btn btn-fill mt-10" data-fade>Plan Your Celebration <Icon name="arrow" class="size-4" /></a>
    </div>
  </section>

  <div class="container-x space-y-[clamp(4rem,8vw,7rem)] py-[clamp(3.5rem,7vw,6rem)]">
    <FeatureRow id="corporate" icon="briefcase" eyebrow="Corporate Events" title="Give Your Team <em>Room to Breathe</em>" image={img.breakfastLawn} alt="Breakfast on the lawn with the A-frames and palms"
      text="One of the most relaxed day-out and retreat venues between Mangalore and Udupi. Teams enjoy outdoor bonding, peaceful surroundings and good food, close to both cities."
      points={corporateOffer} book="corporate" bookLabel="Plan a Corporate Event" />
    <FeatureRow id="photoshoots" icon="camera" eyebrow="Photoshoots" title="A Backdrop <em>Like No Other</em>" image={img.poolReflection} alt="A-frame cottages reflected in the pool" reverse
      text="Pre-wedding, fashion and brand shoots with A-frame cottages, palms, the pool and the delta as your setting, from soft morning light to golden hour."
      points={['A-frames & palms', 'Pool reflections', 'Backwater & sea views', 'Golden-hour light']} book="event" bookLabel="Book a Shoot" />
  </div>

  <!-- venues -->
  <section id="venues" class="scroll-mt-40 pb-[clamp(3.5rem,7vw,6rem)]">
    <div class="container-x">
      <h2 data-split>Spaces for <em>Every Occasion</em></h2>
      <ul class="mt-10 grid gap-3 md:grid-cols-3" data-stagger>
        {eventVenues.map((v) => (
          <li class="group relative aspect-[4/3] overflow-hidden" data-fade>
            <Photo src={v.image} alt={v.title} sizes="(min-width:768px) 32vw, 100vw" class="h-full" imgClass="transition-transform duration-[1.2s] group-hover:scale-105" />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[rgb(23_63_53/0.85)] to-transparent p-5 pt-12 text-white">
              <p class="font-display text-2xl">{v.title}</p><p class="text-sm opacity-85">{v.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-t border-gold/40 bg-champagne py-[clamp(3.5rem,7vw,5.5rem)] text-center text-ink">
    <div class="container-x">
      <h2 data-split>Tell Us About <em>Your Day</em></h2>
      <p class="mx-auto mt-4 max-w-xl text-ink/75" data-fade>Share your date and guest count and we'll come back with ideas, venues and a quote.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3" data-fade>
        <a href={waLink("Hi Tierra! I'd like to plan an event.")} target="_blank" rel="noopener" class="btn btn-fill"><Icon name="whatsapp" class="size-4" /> WhatsApp</a>
        <a href="/contact#enquire" data-book="event" class="btn btn-line on-light">Send Enquiry</a>
        <a href={site.phoneHref} class="btn btn-line on-light">Call {site.phone}</a>
      </div>
    </div>
  </section>
</Base>
