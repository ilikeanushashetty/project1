---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Photo from '@/components/Photo.astro';
import Botanical from '@/components/Botanical.astro';
import PaperEdge from '@/components/PaperEdge.astro';
import Icon from '@/components/Icon.astro';
import { site, img } from '@/data/site';

const values = [
  { n: '01', title: 'Earth first', text: 'We build light and plant more than we pave. Old trees stay, lawns stay open and the cottages sit lightly on the ground.' },
  { n: '02', title: 'Water all around', text: 'The river on one side and the sea on the other set the pace here: the tide, the light and the evening breeze.' },
  { n: '03', title: 'Warm, local hospitality', text: 'A small team from the coast who cook the food they grew up with and know every quiet corner nearby.' },
];
---

<Base title="Our Story" description="Tierra means earth. The story of a small riverside retreat on the delta at Hejamadi, where the river meets the Arabian Sea.">
  <PageHero eyebrow="Our story" title="A small patch of <em>earth</em> by the water" image={img.garden} alt="Gardens and trees at Tierra"
    intro={site.meaning} />

  <!-- Name -->
  <section class="relative overflow-hidden py-[clamp(5rem,12vw,10rem)]">
    <Botanical class="pointer-events-none absolute top-0 right-[-3rem] w-[240px] text-forest/15 md:w-[340px]" />
    <div class="container-x grid gap-14 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <p class="font-display text-[clamp(5rem,14vw,12rem)] leading-none text-forest" data-split><em>Tierra</em></p>
        <p class="mt-4 font-display text-2xl italic text-clay" data-fade>(n.) earth · land · ground</p>
      </div>
      <div class="space-y-6 text-lg leading-relaxed text-ink/75 lg:col-span-6 lg:col-start-7">
        <p class="font-display text-[clamp(1.7rem,3vw,2.6rem)] leading-snug text-ink" data-words>
          We named the place after the ground beneath it, because that is what guests come back for.
        </p>
        <p data-fade>
          Tierra sits on the delta at Hejamadi, on the border of Udupi and Mangaluru, where a slow backwater river finally reaches the Arabian Sea. The land between them is soft sand, coconut palms and old shade trees.
        </p>
        <p data-fade>
          Instead of a big hotel we built a handful of A-frame cottages, riverside tents and rooms around a pool and open lawns, so the trees, the water and the sky stay the main attraction.
        </p>
      </div>
    </div>
  </section>

  <!-- Split image -->
  <section class="container-x grid gap-5 pb-[clamp(5rem,10vw,9rem)] md:grid-cols-12">
    <Photo src={img.aFrame} alt="A-frame cottage" reveal class="aspect-[4/5] md:col-span-5" sizes="(min-width:768px) 40vw, 100vw" />
    <div class="flex flex-col justify-end gap-5 md:col-span-7">
      <Photo src={img.hero} alt="Pool and the sea beyond" reveal class="aspect-[16/10]" sizes="(min-width:768px) 58vw, 100vw" />
      <p class="max-w-md text-sm leading-relaxed text-ink/60" data-fade>
        The resort lies 3 km from the Blue Flag beach at Padubidri and a short walk from the surf club, yet the river side of the land stays still and green.
      </p>
    </div>
  </section>

  <!-- Values -->
  <section class="relative overflow-hidden bg-forest py-[clamp(8rem,14vw,12rem)] text-paper">
    <PaperEdge position="top" variant={2} />
    <div class="container-x">
      <p class="eyebrow mb-4 text-lime" data-fade>What we hold on to</p>
      <h2 class="mb-16 max-w-3xl text-[clamp(2.6rem,5.5vw,5rem)]" data-split>Luxury, the <em>natural</em> way</h2>
      <div class="grid gap-12 md:grid-cols-3" data-stagger>
        {values.map((v) => (
          <div class="border-t border-paper/20 pt-8" data-fade>
            <p class="font-display text-2xl text-lime">{v.n}</p>
            <h3 class="mt-4 text-4xl">{v.title}</h3>
            <p class="mt-4 leading-relaxed text-paper/75">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
    <PaperEdge />
  </section>

  <section class="py-[clamp(5rem,10vw,8rem)] text-center">
    <div class="container-x">
      <h2 class="mx-auto max-w-3xl text-[clamp(2.4rem,5vw,4.5rem)]" data-split>See it for <em>yourself</em></h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3" data-fade>
        <a href="/stays" class="btn btn-fill">Explore stays <Icon name="arrow" class="size-4" /></a>
        <a href="/gallery" class="btn btn-line on-light">View gallery</a>
      </div>
    </div>
  </section>
</Base>
