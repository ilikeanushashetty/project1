---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import FeatureRow from '@/components/FeatureRow.astro';
import Icon from '@/components/Icon.astro';
import { img, poolList, natureList, facilityGroups, site } from '@/data/site';

// everyday comforts (from the facilities list)
const comforts = facilityGroups[0].items;
---

<Base title="Experiences" description="Beach and surfing, yoga by the water, campfire evenings, the backwaters, an outdoor pool and a café with coastal food: things to do at Tierra, Hejamady.">
  <PageHero eyebrow="Experiences" title="Sea, River <em>&amp; Sky</em>" image={img.kayakAerial} focus="object-[22%_50%]" alt="A kayak gliding over the backwater beside the mangroves"
    intro="Everything you need for slow days and starry nights, from the beach to the backwaters." />

  <!-- quick jump -->
  <nav class="sticky top-[var(--hh-now)] transition-[top] duration-500 z-30 border-b border-ink/10 bg-shell/90 backdrop-blur" aria-label="Experiences" data-spy>
    <ul class="container-x flex gap-1 overflow-x-auto py-1 text-[0.78rem] font-semibold tracking-[0.12em] uppercase [scrollbar-width:none]">
      {[['beach', 'Beach & Surf'], ['yoga', 'Yoga'], ['campfire', 'Campfire'], ['backwater', 'Backwaters'], ['pool', 'Pool'], ['dining', 'Café & Kitchen'], ['comforts', 'Comforts']].map(([id, l]) => (
        <li class="shrink-0"><a href={`#${id}`} class="spy-link relative block px-3 py-3 text-ink/70 transition-colors hover:text-teal">{l}</a></li>
      ))}
    </ul>
  </nav>

  <div class="container-x space-y-[clamp(4rem,8vw,7rem)] py-[clamp(3.5rem,7vw,6rem)]">
    <FeatureRow id="beach" icon="umbrella" eyebrow="Beach & Surf" title="The Sea, <em>a Short Walk Away</em>" image={img.contactDusk} focus="object-[50%_15%]" alt="The Arabian Sea and the delta beyond Tierra at dusk"
      text="The beach is just a couple of minutes from your room, and the Blue Flag beach is only 3 km away. Surfers head to the Surf Club, 200 m from the resort."
      points={['Beach a 2-minute walk', 'Blue Flag Beach, 3 km', 'Surf Club, 200 m', 'Sunset walks on the shore']} />
    <FeatureRow id="yoga" icon="yoga" eyebrow="Wellness" title="Yoga <em>by the Water</em>" image={img.sampleYoga} alt="Yoga by the sea at sunset" reverse
      text="Begin the day slowly: a yoga session on the lawn, the backwater still and the palms quiet. Ask us to arrange a session during your stay."
      points={['Morning sessions on the lawn', 'Quiet meditation areas', 'Calm, unhurried mornings']} />
    <FeatureRow id="campfire" icon="fire" eyebrow="Evenings" title="Campfire <em>Under the Stars</em>" image={img.sampleCampfire} alt="Friends around a campfire by the sea at dusk"
      text="As the light fades, gather around the campfire with music, stories and the sound of the sea. Add a barbecue and make a night of it."
      points={['Evening campfire sessions', 'Barbecue setup', 'Candlelight dinners', 'Stargazing on the lawn']} />
    <FeatureRow id="backwater" icon="wave" eyebrow="Nature" title="Where the River <em>Meets the Sea</em>" image={img.kayakAerial} focus="object-[22%_50%]" alt="Kayaking on the backwater" reverse
      text="Tierra sits right at the delta, where the backwater flows into the Arabian Sea. Paddle out, watch the birds, or simply sit by the water and breathe a little easier."
      points={natureList} />
    <FeatureRow id="pool" icon="pool" eyebrow="Pool & Lawns" title="Dive Into <em>Relaxation</em>" image={img.poolReflection} alt="The pool reflecting the A-frame cottages"
      text="An outdoor swimming pool surrounded by palm trees and lawns, with the backwaters just beyond. Spend the afternoon on a lounger, or swim until the sun goes down."
      points={poolList} />
    <FeatureRow id="dining" icon="utensils" eyebrow="Café & Coastal Kitchen" title="Fresh, Coastal, <em>Made to Order</em>" image={img.cafeFood} alt="Coastal snacks served at the café" reverse
      text="Breakfast is included with every stay. For lunch and dinner, order anything from our in-house chef: fresh seafood, coastal specialities and cuisines from across India and beyond, served by the pool or on the lawn."
      points={['Breakfast included', 'Seafood & coastal specialities', 'All cuisines, made to order', "24/7 kids' meals"]} />
  </div>

  <!-- everyday comforts -->
  <section id="comforts" class="scroll-mt-40 bg-champagne py-[clamp(3.5rem,7vw,5.5rem)]">
    <div class="container-x">
      <h2 data-split>All Taken <em>Care Of</em></h2>
      <ul class="mt-10 grid gap-px bg-ink/10 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
        {comforts.map((c) => (
          <li class="flex gap-4 bg-champagne p-6" data-fade>
            <Icon name={c.icon} class="mt-0.5 size-6 shrink-0 text-teal" />
            <div><p class="font-display text-xl">{c.title}</p><p class="mt-1 text-[0.95rem] text-ink/70">{c.text}</p></div>
          </li>
        ))}
      </ul>
      <div class="mt-10 flex flex-wrap gap-3" data-fade>
        <a href="/contact#enquire" data-book="" class="btn btn-fill">Book Your Stay <Icon name="arrow" class="size-4" /></a>
        <a href={site.phoneHref} class="btn btn-line on-light">Call {site.phone}</a>
      </div>
    </div>
  </section>
</Base>
