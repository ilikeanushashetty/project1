---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Photo from '@/components/Photo.astro';
import PaperEdge from '@/components/PaperEdge.astro';
import Icon from '@/components/Icon.astro';
import { img, amenities, experiences } from '@/data/site';
---

<Base title="Experiences" description="Corporate day-outs, celebrations, beach and surf, bonfires and backwater walks at Tierra on the Karnataka coast.">
  <PageHero eyebrow="Experiences" title="Days shaped by <em>river</em> &amp; sea" image={img.pool} alt="Swimming pool at Tierra"
    intro="Gather your team, celebrate with family or simply do nothing at all." />

  <section class="py-[clamp(4rem,8vw,7rem)]">
    <div class="container-x space-y-[clamp(5rem,10vw,9rem)]">
      {experiences.map((e, i) => (
        <article class="grid items-end gap-10 lg:grid-cols-12">
          <div class:list={['relative lg:col-span-7', i % 2 === 1 && 'lg:order-2 lg:col-start-6']}>
            <Photo src={e.image} alt={e.title} reveal class="aspect-[16/11]" sizes="(min-width:1024px) 58vw, 100vw" />
            <span class="absolute -top-6 left-4 font-display text-[clamp(4rem,9vw,8rem)] leading-none text-forest/15 md:-left-6" aria-hidden="true">0{i + 1}</span>
          </div>
          <div class:list={['lg:col-span-5', i % 2 === 1 ? 'lg:order-1 lg:col-start-1' : '']}>
            <h2 class="text-[clamp(2.4rem,4.5vw,4rem)]" data-split>{e.title}</h2>
            <p class="mt-6 leading-relaxed text-ink/70" data-fade>{e.text}</p>
            <ul class="mt-6 flex flex-wrap gap-2" data-stagger>
              {e.points.map((p) => <li class="rounded-full border border-forest/25 px-4 py-2 text-xs tracking-wide text-forest" data-fade>{p}</li>)}
            </ul>
            <a href="/contact#book" class="btn btn-fill mt-8" data-fade>Plan with us <Icon name="arrow" class="size-4" /></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="relative overflow-hidden bg-forest py-[clamp(8rem,14vw,12rem)] text-paper">
    <PaperEdge position="top" variant={2} />
    <div class="container-x">
      <p class="eyebrow mb-4 text-lime" data-fade>Facilities</p>
      <h2 class="mb-14 text-[clamp(2.6rem,5.5vw,5rem)]" data-split>Everything, <em>within a stroll</em></h2>
      <ul class="grid gap-px overflow-hidden rounded-[2px] bg-paper/10 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
        {amenities.map((a) => (
          <li class="bg-forest p-8 md:p-10" data-fade>
            <Icon name={a.icon} class="size-9 text-lime" />
            <h3 class="mt-8 text-3xl">{a.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-paper/70">{a.text}</p>
          </li>
        ))}
      </ul>
    </div>
    <PaperEdge />
  </section>
</Base>
