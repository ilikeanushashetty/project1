---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Photo from '@/components/Photo.astro';
import Icon from '@/components/Icon.astro';
import { site, img, stays } from '@/data/site';
---

<Base title="Stays" description="A-frame cottages, semi A-frames, riverside tents and luxury rooms at Tierra, a riverside eco-retreat near Udupi and Mangaluru.">
  <PageHero eyebrow="Stays" title="Sleep close to the <em>earth</em>" image={img.aFrame} alt="A-frame cottage at Tierra"
    intro="Four kinds of stay, each a few steps from the lawns, the pool and the river." />

  <section class="py-[clamp(4rem,8vw,7rem)]">
    <div class="container-x space-y-[clamp(5rem,10vw,9rem)]">
      {stays.map((s, i) => (
        <article id={s.slug} class="grid scroll-mt-28 items-center gap-10 lg:grid-cols-12 lg:gap-16">
          <div class:list={['lg:col-span-7', i % 2 === 1 && 'lg:order-2 lg:col-start-6']}>
            <Photo src={s.image} alt={s.name} reveal class="aspect-[5/4]" sizes="(min-width:1024px) 58vw, 100vw" />
          </div>
          <div class:list={['lg:col-span-5', i % 2 === 1 ? 'lg:order-1 lg:col-start-1' : '']}>
            <p class="eyebrow mb-4 text-clay" data-fade>0{i + 1} · {s.kicker}</p>
            <h2 class="text-[clamp(2.6rem,4.5vw,4.2rem)]" data-split>{s.name}</h2>
            <p class="mt-6 leading-relaxed text-ink/70" data-fade>{s.blurb}</p>
            <p class="mt-6 flex items-center gap-2 text-sm text-ink/70" data-fade><Icon name="users" class="size-4 text-forest" /> {s.guests}</p>
            <ul class="mt-6 grid grid-cols-2 gap-3 border-t border-ink/10 pt-6 text-sm" data-stagger>
              {s.features.map((f) => <li class="flex items-center gap-2" data-fade><Icon name="check" class="size-4 text-leaf" />{f}</li>)}
            </ul>
            <div class="mt-8 flex flex-wrap gap-3" data-fade>
              <a href={`/contact?stay=${encodeURIComponent(s.name)}#book`} class="btn btn-fill">Enquire <Icon name="arrow" class="size-4" /></a>
              <a href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Hi! I'd like to check availability for the ${s.name}.`)}`} target="_blank" rel="noopener" class="btn btn-line on-light">WhatsApp</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-sand/60 py-[clamp(4rem,8vw,6rem)]">
    <div class="container-x grid gap-8 text-sm md:grid-cols-3" data-stagger>
      <div data-fade><p class="eyebrow mb-2 text-clay">Check-in</p><p class="font-display text-3xl">{site.checkIn}</p></div>
      <div data-fade><p class="eyebrow mb-2 text-clay">Check-out</p><p class="font-display text-3xl">{site.checkOut}</p></div>
      <div data-fade><p class="eyebrow mb-2 text-clay">Reservations</p><a href={site.phoneHref} class="font-display text-3xl link-u">{site.phone}</a></div>
    </div>
  </section>
</Base>
