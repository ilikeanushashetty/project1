---
/**
 * The one page hero for every inner page: a full-width photo, the title and a
 * short line centred over an even shade, and the drifting wave edge into the
 * white page below (the same family as the home video). Optional buttons go in
 * the default slot. `nowrap` keeps the title on one line at every width.
 */
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import WaveEdge from './WaveEdge.astro';

interface Props {
  eyebrow?: string; // section name, not shown
  title: string;
  intro?: string;
  image: ImageMetadata;
  alt: string;
  focus?: string; // object-position class to aim the crop, e.g. 'object-top'
  nowrap?: boolean;
}
const { title, intro, image, alt, focus = '', nowrap = false } = Astro.props;
---

<section data-hero class="relative flex h-[clamp(440px,64svh,640px)] items-center justify-center overflow-hidden bg-night text-paper">
  <div class="absolute inset-0" data-hero-media>
    <Photo src={image} alt={alt} priority sizes="100vw" class="h-full" imgClass={focus} />
  </div>
  <!-- an even shade, a little deeper in the middle where the words sit -->
  <div class="absolute inset-0 bg-[radial-gradient(70%_60%_at_50%_50%,rgb(16_24_28/0.5),rgb(16_24_28/0.28))]"></div>
  <div class="container-x relative z-[3] pb-10 text-center">
    <h1 class:list={['mx-auto [text-shadow:0_2px_30px_rgb(16_24_28/0.45)]', nowrap ? 'text-[clamp(1.2rem,7vw,4.25rem)] whitespace-nowrap' : 'max-w-4xl']} data-split set:html={title} />
    {intro && <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-paper/90 md:text-lg" data-fade>{intro}</p>}
    {Astro.slots.has('default') && <div class="mt-8 flex flex-wrap justify-center gap-3" data-fade><slot /></div>}
  </div>
  <WaveEdge fill="#ffffff" class="z-[4]" />
</section>
