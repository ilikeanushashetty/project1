---
/** Clean square photo frame with an optional small caption (luxury square theme). */
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  sizes?: string;
  ratio?: string;
  class?: string;
}
const { src, alt, caption, sizes = '(min-width:1024px) 30vw, 80vw', ratio = 'aspect-[4/5]', class: cls = '' } = Astro.props;
---

<figure class:list={['group', cls]}>
  <div class:list={['relative overflow-hidden', ratio]}>
    <Photo src={src} alt={alt} sizes={sizes} class="h-full"
      imgClass="transition-transform duration-[1.4s] ease-[var(--ease-out-expo)] group-hover:scale-105" />
  </div>
  {caption && <figcaption class="eyebrow mt-3 text-[0.72rem] text-clay">{caption}</figcaption>}
</figure>
