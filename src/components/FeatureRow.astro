---
/**
 * One experience / event: photo (or placeholder until real photos arrive) beside a heading,
 * a short paragraph, a few facts and a booking button. Alternates sides with `reverse`.
 */
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';

interface Props {
  id: string;
  eyebrow?: string; // section name, not shown
  title: string;                 // may contain <em>
  text: string;
  points?: string[];
  icon: string;
  image?: ImageMetadata;
  alt?: string;
  focus?: string;
  book?: string;                 // booking panel preselect
  bookLabel?: string;
  reverse?: boolean;
}
const { id, title, text, points = [], icon, image, alt = '', focus, book = '', bookLabel = 'Book Now', reverse = false } = Astro.props;
---

<article id={id} class="grid scroll-mt-28 items-center gap-8 lg:grid-cols-12 lg:gap-14">
  <div class:list={['lg:col-span-6', reverse && 'lg:order-2 lg:col-start-7']}>
    {image ? (
      <Photo src={image} alt={alt} reveal class="aspect-[5/4]" imgClass={focus} sizes="(min-width:1024px) 46vw, 100vw" />
    ) : (
      <div class="ph flex aspect-[5/4] flex-col items-center justify-center text-ink/70" aria-hidden="true">
        <Icon name={icon} class="size-14" />
        <span class="mt-4 text-[0.75rem] font-semibold tracking-[0.16em] uppercase opacity-75">Photo coming soon</span>
      </div>
    )}
  </div>
  <div class:list={['lg:col-span-5', reverse ? 'lg:order-1 lg:col-start-1' : 'lg:col-start-8']}>
    <h2 data-split set:html={title} />
    <p class="mt-5 leading-relaxed text-ink/75" data-fade>{text}</p>
    {points.length > 0 && (
      <ul class="mt-6 grid gap-x-6 gap-y-2.5 sm:grid-cols-2" data-fade>
        {points.map((p) => <li class="flex gap-2.5 text-[0.98rem] text-ink/85"><Icon name="check" class="mt-1 size-4 shrink-0 text-teal" />{p}</li>)}
      </ul>
    )}
    <a href="/contact#enquire" data-book={book} class="btn btn-line on-light mt-8" data-fade>{bookLabel} <Icon name="arrow" class="size-4" /></a>
  </div>
</article>

<style>
  .ph { background: linear-gradient(160deg, #c2d5d3, #a0c1bd 55%, #86b1af); }
</style>
