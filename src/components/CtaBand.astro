---
/** Closing call-to-action band: light champagne so it stands apart from the emerald footer. */
import Icon from './Icon.astro';

interface Action { label: string; href: string; external?: boolean }
interface Props {
  eyebrow?: string; // section name, not shown
  title: string;
  text: string;
  actions: Action[];
}
const { title, text, actions } = Astro.props;
---

<section class="relative overflow-hidden border-t border-gold/40 bg-champagne py-[clamp(4rem,8vw,6.5rem)] text-ink">
  <div class="container-x relative text-center">
    <h2 class="mx-auto max-w-4xl" data-split set:html={title} />
    <p class="mx-auto mt-6 max-w-xl leading-relaxed text-ink/75" data-fade>{text}</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3" data-fade>
      {actions.map((a, i) => (
        <a href={a.href} class:list={['btn', i === 0 ? 'btn-fill' : 'btn-line on-light']} {...(a.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
          {a.label}{i === 0 && <Icon name="arrow" class="size-4" />}
        </a>
      ))}
    </div>
  </div>
</section>
