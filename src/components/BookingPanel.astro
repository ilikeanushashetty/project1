---
/**
 * Booking box, available on every page: a square frosted-glass box centred on the screen. Anything with [data-book] opens it
 * (data-book="slug" preselects a stay or event; data-book="" leaves the choice open).
 * Links keep href="/contact#enquire" so booking still works without JavaScript.
 */
import EnquiryForm from './EnquiryForm.astro';
import Icon from './Icon.astro';
import { site } from '@/data/site';
---

<dialog id="booking-panel" class="book-panel" aria-labelledby="book-title" data-lenis-prevent>
  <div class="book-sheet">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 id="book-title">Plan <em>your escape</em></h2>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-ink/70">Send your dates on WhatsApp for the quickest reply, or by email. Prefer to talk? Call <a href={site.phoneHref} class="font-semibold whitespace-nowrap text-teal">{site.phone}</a>.</p>
      </div>
      <button type="button" class="grid size-11 shrink-0 place-items-center rounded-[2px] border border-ink/20 transition-colors hover:bg-white/70" data-book-close aria-label="Close booking panel"><Icon name="close" class="size-5" /></button>
    </div>
    <div class="mt-7"><EnquiryForm compact /></div>
    <p class="mt-4 text-center text-[0.84rem] text-ink-muted">Breakfast included · We reply within the hour</p>
  </div>
</dialog>

<style>
  /* centred, square frosted glass: the page shows softly through it */
  .book-panel {
    margin: auto; width: min(calc(100% - 2rem), 34rem); max-width: none; max-height: min(88svh, 52rem); padding: 0; overflow: hidden;
    border-radius: 2px; border: 1px solid rgb(255 255 255 / 0.75); color: var(--color-ink);
    background: linear-gradient(150deg, rgb(255 255 255 / 0.82) 0%, rgb(255 255 255 / 0.68) 100%);
    backdrop-filter: blur(26px) saturate(1.3); -webkit-backdrop-filter: blur(26px) saturate(1.3);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.95), 0 40px 90px -30px rgb(22 32 38 / 0.55);
  }
  .book-panel::backdrop { background: rgb(22 32 38 / 0.32); backdrop-filter: blur(3px); }
  .book-sheet { max-height: min(88svh, 52rem); overflow-y: auto; overscroll-behavior: contain; padding: clamp(1.5rem, 4vw, 2.5rem); }
  .book-panel[open] { animation: book-in 0.5s var(--ease-out-expo); }
  .book-panel[open]::backdrop { animation: book-fade 0.4s ease; }
  @keyframes book-in { from { opacity: 0; transform: translateY(18px) scale(0.97); } }
  @keyframes book-fade { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .book-panel[open], .book-panel[open]::backdrop { animation: none; } }
</style>

<script>
  const dlg = document.getElementById('booking-panel') as HTMLDialogElement;
  const form = dlg.querySelector<HTMLElement>('[data-enquiry]')!;
  const open = (detail: Record<string, string | undefined>) => {
    form.dispatchEvent(new CustomEvent('enquiry:prefill', { detail }));
    dlg.showModal();
    dispatchEvent(new Event('lenis:stop'));
  };
  // event delegation: works for buttons added anywhere on the page
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-book]');
    if (!t) return;
    e.preventDefault();
    open({ stay: t.dataset.book || undefined });
  });
  // the home page's availability bar hands over its dates
  addEventListener('book:open', ((e: CustomEvent<Record<string, string | undefined>>) => open(e.detail)) as EventListener);
  dlg.querySelector('[data-book-close]')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('close', () => dispatchEvent(new Event('lenis:start')));
</script>
