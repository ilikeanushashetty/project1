---
/**
 * Phones: a slim bottom bar (Call · WhatsApp · Enquire) that never covers content.
 * Larger screens: a single floating WhatsApp button.
 */
import { site, waLink } from '@/data/site';
import Icon from './Icon.astro';
const WA_PATH = 'M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.2-.2.3-.8 1-.9 1.1-.2.2-.4.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5v-.5c-.1-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3Zm-5.4 7.4a9.9 9.9 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4a9.9 9.9 0 1 1 8.3 4.6Zm8.4-18.3A11.8 11.8 0 0 0 1.7 17.8L0 24l6.3-1.7a11.9 11.9 0 0 0 5.7 1.5A11.9 11.9 0 0 0 20.5 3.5Z';
---

<!-- larger screens: floating WhatsApp -->
<a href={waLink()} target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp"
   class="wa-float fixed right-8 bottom-8 z-40 hidden size-14 place-items-center rounded-[2px] bg-sea text-ink shadow-[0_10px_30px_-8px_rgb(0_0_0/0.4)] transition-transform duration-500 ease-[var(--ease-out-expo)] hover:scale-110 md:grid">
  <svg viewBox="0 0 24 24" class="size-7 fill-current" aria-hidden="true"><path d={WA_PATH} /></svg>
</a>

<!-- phones: bottom action bar, plus a spacer so the footer isn't hidden behind it -->
<nav class="mbar fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-ink/10 bg-shell text-ink md:hidden" aria-label="Quick contact">
  <a href={site.phoneHref} class="mbar-item"><Icon name="phone" class="size-5" /><span>Call</span></a>
  <a href={waLink()} target="_blank" rel="noopener noreferrer" class="mbar-item"><svg viewBox="0 0 24 24" class="size-5 fill-current" aria-hidden="true"><path d={WA_PATH} /></svg><span>WhatsApp</span></a>
  <a href="/contact#enquire" data-book="" class="mbar-item bg-sea text-ink"><Icon name="calendar" class="size-5" /><span>Book</span></a>
</nav>
<div class="h-[calc(3.6rem+env(safe-area-inset-bottom))] bg-white md:hidden" aria-hidden="true"></div>

<style>
  .mbar { padding-bottom: env(safe-area-inset-bottom); }
  .mbar-item { display: flex; height: 3.6rem; align-items: center; justify-content: center; gap: 0.5rem; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .mbar-item + .mbar-item { border-left: 1px solid rgb(22 32 38 / 0.1); }
  .wa-float { transition: transform 0.5s var(--ease-out-expo); }
</style>
