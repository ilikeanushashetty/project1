---
/**
 * Sliding guest reviews: one review at a time in a square card.
 * Auto-advances (not for reduced-motion visitors), pauses on hover / focus,
 * prev / next buttons, position markers, keyboard arrows and touch swipe.
 */
import Icon from './Icon.astro';

interface Review { quote: string; name: string; from: string }
interface Props { reviews: Review[]; rating: number; count: number; url: string }
const { reviews, rating, count, url } = Astro.props;
const starPath = 'M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5-4.8-4.6 6.6-.9z';
---

<div class="testimonials" data-testimonials>
  <!-- rating summary -->
  <div class="mb-12 flex flex-col items-center gap-3 text-center" data-fade>
    <div class="flex items-center gap-4">
      <span class="font-display text-5xl leading-none">{rating.toFixed(1)}</span>
      <span class="relative inline-block" aria-hidden="true">
        <span class="flex gap-1 text-mangrove/20">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24" class="size-5 fill-current"><path d={starPath} /></svg>)}</span>
        <span class="absolute inset-0 flex gap-1 overflow-hidden text-teal" style={`width:${(rating / 5) * 100}%`}>{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24" class="size-5 shrink-0 fill-current"><path d={starPath} /></svg>)}</span>
      </span>
    </div>
    <p class="text-sm text-ink/70"><span class="sr-only">Rated {rating} out of 5 from </span>{count} Google reviews · <a href={url} target="_blank" rel="noopener" class="font-semibold text-gold-deep underline underline-offset-4">Read all reviews on Google</a></p>
  </div>

  <!-- slider -->
  <div class="relative mx-auto max-w-4xl" role="region" aria-roledescription="carousel" aria-label="Guest reviews">
    <div class="overflow-hidden bg-paper">
      <ul class="t-track flex" data-track>
        {reviews.map((r, i) => (
          <li class="t-slide w-full shrink-0 px-8 py-14 text-center md:px-20 md:py-20" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${reviews.length}`} aria-hidden={i === 0 ? 'false' : 'true'}>
            <figure>
              <span class="block font-display text-7xl leading-[0.5] text-sea-light" aria-hidden="true">“</span>
              <blockquote class="mt-6 font-display text-[clamp(1.5rem,3vw,2.4rem)] leading-[1.3] text-ink">{r.quote}</blockquote>
              <figcaption class="mt-8">
                <span class="block font-semibold text-ink">{r.name}</span>
                <span class="eyebrow mt-1 block text-clay">{r.from}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-6 flex items-center justify-center gap-6">
      <button type="button" class="t-prev grid size-11 place-items-center border border-ink/25 transition-colors hover:border-mangrove hover:bg-mangrove hover:text-shell" aria-label="Previous review"><Icon name="arrow" class="size-4 rotate-180" /></button>
      <div class="flex gap-2" role="tablist" aria-label="Choose a review">
        {reviews.map((_, i) => (
          <button type="button" class="t-dot h-[3px] w-8 bg-ink/20 transition-colors" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Review ${i + 1}`} data-i={i}></button>
        ))}
      </div>
      <button type="button" class="t-next grid size-11 place-items-center border border-ink/25 transition-colors hover:border-mangrove hover:bg-mangrove hover:text-shell" aria-label="Next review"><Icon name="arrow" class="size-4" /></button>
    </div>
    <p class="sr-only" aria-live="polite" data-live></p>
  </div>
</div>

<style>
  .t-track { transition: transform 0.9s var(--ease-out-expo); }
  .t-dot[aria-selected='true'] { background: var(--color-gold-deep); }
  @media (prefers-reduced-motion: reduce) { .t-track { transition: none; } }
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-testimonials]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.t-slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.t-dot'));
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    let i = 0;
    let timer: number | undefined;

    const go = (n: number, announce = false) => {
      i = (n + slides.length) % slides.length;
      track.style.transform = `translateX(-${i * 100}%)`;
      slides.forEach((s, j) => s.setAttribute('aria-hidden', String(j !== i)));
      dots.forEach((d, j) => d.setAttribute('aria-selected', String(j === i)));
      if (announce) live.textContent = `Review ${i + 1} of ${slides.length}`;
    };
    const stop = () => window.clearInterval(timer);
    const start = () => { stop(); if (!reduced && slides.length > 1) timer = window.setInterval(() => go(i + 1), 6000); };

    root.querySelector('.t-prev')!.addEventListener('click', () => { go(i - 1, true); start(); });
    root.querySelector('.t-next')!.addEventListener('click', () => { go(i + 1, true); start(); });
    dots.forEach((d) => d.addEventListener('click', () => { go(Number(d.dataset.i), true); start(); }));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { go(i + 1, true); start(); }
      if (e.key === 'ArrowLeft') { go(i - 1, true); start(); }
    });
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    // touch swipe
    let x0: number | null = null;
    track.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
    track.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 40) { go(dx < 0 ? i + 1 : i - 1, true); start(); }
      x0 = null;
    });

    new IntersectionObserver(([en]) => (en.isIntersecting ? start() : stop()), { threshold: 0.3 }).observe(root);
  });
</script>
