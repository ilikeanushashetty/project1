---
/**
 * One row of small review cards drifting sideways, plus one
 * "more reviews on Google" card. Pauses on hover/focus; static (scrollable)
 * for reduced-motion visitors.
 */
import Icon from './Icon.astro';

interface Review { quote: string; name: string; from: string }
interface Props { reviews: Review[]; rating: number; count: number; url: string }
const { reviews, rating, count, url } = Astro.props;
const starPath = 'M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5-4.8-4.6 6.6-.9z';
// the reviews followed by the Google card
const row = [...reviews.map((r) => ({ kind: 'review' as const, r })), { kind: 'google' as const }];
type Item = (typeof row)[number];
---

<div class="marquee relative" aria-label="Guest reviews">
  <div class="m-row">
      <ul class="m-track">
        {/* the row is rendered twice so the loop is seamless; the copy is hidden from screen readers */}
        {[0, 1].map((copy) =>
          row.map((it: Item) =>
            it.kind === 'review' ? (
              <li class="m-card review-card flex w-[300px] shrink-0 flex-col md:w-[420px]" aria-hidden={copy === 1 ? 'true' : undefined}>
                <blockquote class="text-[1.2rem] leading-[1.5] text-ink md:text-[1.35rem]">“{it.r.quote}”</blockquote>
                <p class="mt-auto pt-8 text-[0.78rem] tracking-[0.14em] text-ink-muted uppercase">{it.r.name}</p>
              </li>
            ) : (
              <li class="m-card w-[300px] shrink-0 md:w-[340px]" aria-hidden={copy === 1 ? 'true' : undefined}>
                <a href={url} target="_blank" rel="noopener" class="review-card flex h-full flex-col justify-between text-ink transition-colors hover:bg-[#f1e9da]" tabindex={copy === 1 ? -1 : undefined}>
                  <span class="flex items-center gap-3">
                    <span class="font-display text-4xl leading-none">{rating.toFixed(1)}</span>
                    <span class="flex gap-0.5 text-ink" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24" class="size-4 fill-current"><path d={starPath} /></svg>)}</span>
                  </span>
                  <span class="mt-3 block text-sm text-ink">{count} reviews on Google</span>
                  <span class="eyebrow mt-4 inline-flex items-center gap-2 text-ink">Read more reviews <Icon name="arrow" class="size-4" /></span>
                </a>
              </li>
            ),
          ),
        )}
      </ul>
  </div>
</div>

<style>
  .marquee { display: grid; gap: 1.25rem; mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent); }
  .m-row { overflow: hidden; }
  .m-track { --m-gap: clamp(1.25rem, 3vw, 3rem); display: flex; gap: var(--m-gap); width: max-content; animation: m-scroll 60s linear infinite; padding-block: 0.5rem 1.5rem; }
  .marquee:hover .m-track, .marquee:focus-within .m-track { animation-play-state: paused; }
  .m-card { transition: transform 0.5s var(--ease-out-expo); }
  .m-card:hover { transform: translateY(-4px); }
  /* review cards (after the reference the user liked): a quiet sand panel with a hairline,
     the quote in the site serif and the guest's name in small capitals; square corners */
  .review-card { border-radius: 2px; background: var(--color-sand); border: 1px solid rgb(217 196 154 / 0.55); padding: clamp(1.75rem, 3vw, 2.6rem); }
  /* the track holds two copies, so moving it by half loops perfectly */
  @keyframes m-scroll { to { transform: translateX(calc(-50% - var(--m-gap) / 2)); } }
  @media (prefers-reduced-motion: reduce) {
    .m-track { animation: none; }
    .m-row { overflow-x: auto; }
  }
</style>
