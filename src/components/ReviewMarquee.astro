---
/**
 * One row of small review cards drifting sideways, plus one
 * "more reviews on Google" card. Pauses on hover/focus; static (scrollable)
 * for reduced-motion visitors.
 */
import Icon from './Icon.astro';

interface Review { quote: string; name: string; from: string }
interface Props { reviews: Review[]; rating: number; count: number; url: string }
const { reviews, rating, count, url } = Astro.props;
const starPath = 'M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5-4.8-4.6 6.6-.9z';
const initials = (n: string) => n.split(/\s+/).map((p) => p[0]).join('').slice(0, 2).toUpperCase();
// the reviews followed by the Google card
const row = [...reviews.map((r) => ({ kind: 'review' as const, r })), { kind: 'google' as const }];
type Item = (typeof row)[number];
---

<div class="marquee relative" aria-label="Guest reviews">
  <div class="m-row">
      <ul class="m-track">
        {/* the row is rendered twice so the loop is seamless; the copy is hidden from screen readers */}
        {[0, 1].map((copy) =>
          row.map((it: Item) =>
            it.kind === 'review' ? (
              <li class="m-card glass-card relative w-[260px] md:w-[300px] shrink-0 p-6" aria-hidden={copy === 1 ? 'true' : undefined}>
                <span class="absolute top-3 right-5 font-display text-6xl leading-none text-gold/40" aria-hidden="true">“</span>
                <div class="flex items-center gap-3">
                  <span class="grid size-10 shrink-0 place-items-center rounded-[2px] border border-sand-light bg-white text-[0.8rem] font-semibold tracking-[0.06em] text-ink" aria-hidden="true">{initials(it.r.name)}</span>
                  <span>
                    <span class="block text-sm font-bold text-ink">{it.r.name}</span>
                    <span class="eyebrow block text-[0.75rem] text-ink/70">{it.r.from}</span>
                  </span>
                </div>
                <blockquote class="mt-4 font-display text-[1.15rem] leading-snug text-ink">{it.r.quote}</blockquote>
              </li>
            ) : (
              <li class="m-card w-[260px] md:w-[300px] shrink-0" aria-hidden={copy === 1 ? 'true' : undefined}>
                <a href={url} target="_blank" rel="noopener" class="glass-card glass-strong flex h-full flex-col justify-between p-6 text-ink transition-colors" tabindex={copy === 1 ? -1 : undefined}>
                  <span class="flex items-center gap-3">
                    <span class="font-display text-4xl leading-none">{rating.toFixed(1)}</span>
                    <span class="flex gap-0.5 text-gold-deep" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24" class="size-4 fill-current"><path d={starPath} /></svg>)}</span>
                  </span>
                  <span class="mt-3 block text-sm text-ink/75">{count} reviews on Google</span>
                  <span class="eyebrow mt-4 inline-flex items-center gap-2 text-teal">Read more reviews <Icon name="arrow" class="size-4" /></span>
                </a>
              </li>
            ),
          ),
        )}
      </ul>
  </div>
</div>

<style>
  .marquee { display: grid; gap: 1.25rem; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .m-row { overflow: hidden; }
  .m-track { display: flex; gap: 1.25rem; width: max-content; animation: m-scroll 55s linear infinite; padding-block: 1rem 3rem; } /* room for the glass shadows */
  .marquee:hover .m-track, .marquee:focus-within .m-track { animation-play-state: paused; }
  .m-card { transition: transform 0.5s var(--ease-out-expo); }
  .m-card:hover { transform: translateY(-4px); }
  /* clear glass on white: a transparent pane with a fine edge, a bright top line
     and a soft floating shadow; square corners */
  .glass-card {
    border-radius: 2px;
    background: rgb(255 255 255 / 0.6);
    border: 1px solid rgb(34 48 46 / 0.09);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 1),
      0 18px 40px -30px rgb(34 48 46 / 0.3);
  }
  .glass-strong { background: var(--color-sand); }
  .glass-strong:hover { background: #f1e9da; }
  /* the track holds two copies, so moving it by half loops perfectly */
  @keyframes m-scroll { to { transform: translateX(calc(-50% - 0.625rem)); } }
  @media (prefers-reduced-motion: reduce) {
    .m-track { animation: none; }
    .m-row { overflow-x: auto; }
  }
</style>
