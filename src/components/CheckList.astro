---
import Icon from './Icon.astro';
interface Props { items: string[]; dark?: boolean; cols?: 1 | 2; class?: string }
const { items, dark = false, cols = 1, class: cls = '' } = Astro.props;
---

<ul class:list={['grid gap-x-8 gap-y-4', cols === 2 && 'sm:grid-cols-2', cls]} data-stagger>
  {items.map((t) => (
    <li class:list={['flex items-start gap-3 leading-relaxed', dark ? 'text-paper/85' : 'text-ink/80']} data-fade>
      <span class:list={['mt-0.5 grid size-6 shrink-0 place-items-center rounded-none', dark ? 'bg-lime text-mangrove' : 'bg-teal text-shell']}><Icon name="check" class="size-3.5" /></span>
      <span>{t}</span>
    </li>
  ))}
</ul>
