---
/**
 * Torn watercolour-paper edge used between sections.
 * Place it at the top or bottom of a section; `fill` is the colour of the
 * section it leads INTO (or out of).
 */
interface Props {
  fill?: string;
  position?: 'top' | 'bottom';
  variant?: 1 | 2;
  class?: string;
}
const { fill = 'var(--color-paper)', position = 'bottom', variant = 1, class: cls = '' } = Astro.props;

const paths = {
  1: 'M0 64 C 60 52 96 78 156 70 S 250 40 318 52 S 418 86 486 74 S 566 44 640 50 S 742 82 812 76 S 906 46 980 54 S 1086 84 1160 72 S 1258 44 1330 56 S 1410 74 1440 66 L1440 140 L0 140 Z',
  2: 'M0 58 C 48 70 110 46 170 54 S 262 80 336 70 S 430 38 508 50 S 600 84 676 72 S 778 42 852 52 S 952 80 1028 70 S 1120 40 1200 50 S 1300 82 1372 70 S 1424 56 1440 60 L1440 140 L0 140 Z',
};
// a second, lighter layer for the soft watercolour "bleed"
const bleed = {
  1: 'M0 46 C 80 36 140 64 220 56 S 360 28 450 40 S 600 70 700 60 S 860 30 960 42 S 1120 72 1220 60 S 1380 34 1440 44 L1440 140 L0 140 Z',
  2: 'M0 40 C 90 52 170 30 260 38 S 420 66 520 56 S 680 26 780 36 S 960 68 1060 56 S 1220 28 1320 38 S 1420 50 1440 46 L1440 140 L0 140 Z',
};
---

<div aria-hidden="true" class:list={['pointer-events-none absolute inset-x-0 z-[2] h-[clamp(48px,7vw,110px)] leading-[0]', position === 'bottom' ? 'bottom-[-1px]' : 'top-[-1px] rotate-180', cls]}>
  <svg viewBox="0 0 1440 140" preserveAspectRatio="none" class="h-full w-full">
    <path d={bleed[variant]} fill={fill} opacity="0.45" />
    <path d={paths[variant]} fill={fill} />
  </svg>
</div>
