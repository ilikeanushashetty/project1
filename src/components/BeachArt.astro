---
/**
 * A flat, illustrated aerial beach in landscape: layered turquoise sea with fine white
 * contour lines, a white foam band, and speckled sand, plus a small rowing boat with
 * ripples, a beach umbrella and a few sparkles. Original artwork in the Tierra palette.
 * Fills its positioned parent (cropped to fit, never stretched). The contour lines drift
 * and the foam washes gently; everything pauses off-screen and stays still for reduced motion.
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;

const W = 1600, H = 720;
let seed = 23;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);

// a soft horizontal wave line across twice the width (so a -50% drift loops seamlessly)
const wave = (y: number, amp: number, period: number, phase: number) => {
  const pts: string[] = [];
  for (let x = 0; x <= W * 2; x += 16) pts.push(`${x} ${(y + amp * Math.sin((2 * Math.PI * x) / period + phase) + amp * 0.35 * Math.sin((2 * Math.PI * x) / (period / 2.7) + phase * 1.7)).toFixed(1)}`);
  return pts;
};
const line = (pts: string[]) => `M${pts.join(' L')}`;
const band = (pts: string[]) => `M0 0 L${pts.join(' L')} L${W * 2} 0 Z`; // fills everything above the line

const period = 800; // W*2 is a whole number of periods, so the drift is seamless
// sea bands, deepest first (each fills from the top down to its edge)
const bands = [
  { y: 520, amp: 26, ph: 0.4, fill: '#bfe3df' }, // shallows
  { y: 430, amp: 30, ph: 1.3, fill: '#86c9c4' }, // turquoise
  { y: 330, amp: 28, ph: 2.1, fill: '#5ea9a8' }, // mid
  { y: 220, amp: 24, ph: 2.9, fill: '#2f7f86' }, // deep
].map((b) => ({ ...b, d: band(wave(b.y, b.amp, period, b.ph)) }));
// fine contour lines in the water
const contours = [120, 170, 260, 300, 380, 470].map((y, i) => line(wave(y, 18 + (i % 3) * 6, period, 0.8 + i * 0.55)));
// the shore: foam (white) and the wet-sand edge below it
const foamPts = wave(585, 22, period, 0.2);
const foam = band(foamPts);
const foamEdge = line(foamPts);
// sand speckles and sparkles
const speckles = Array.from({ length: 260 }, () => ({ x: rnd() * W, y: 600 + rnd() * 120, r: 0.8 + rnd() * 1.4, o: 0.25 + rnd() * 0.45 }));
const dots = Array.from({ length: 140 }, () => ({ x: rnd() * W, y: rnd() * 520, r: 0.6 + rnd() * 1.1, o: 0.18 + rnd() * 0.3 }));
const sparkles = [[1180, 150, 9], [300, 300, 7], [1460, 380, 6], [820, 90, 6], [560, 470, 5]];
const star = (x: number, y: number, s: number) => `M${x} ${y - s} Q${x} ${y} ${x + s} ${y} Q${x} ${y} ${x} ${y + s} Q${x} ${y} ${x - s} ${y} Q${x} ${y} ${x} ${y - s}Z`;
---

<div class:list={['beach-art pointer-events-none absolute inset-0 overflow-hidden', cls]} aria-hidden="true" data-beach-art>
  <svg class="h-full w-full" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    <!-- sand -->
    <rect width={W} height={H} fill="#f2e8d6" />
    <g fill="#c8b48a">{speckles.map((p) => <circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r={p.r.toFixed(2)} opacity={p.o.toFixed(2)} />)}</g>

    <!-- foam and sea drift slowly sideways -->
    <g class="drift drift-slow">
      <path d={foam} fill="#ffffff" />
      <path d={foamEdge} fill="none" stroke="#e3d7bd" stroke-width="2" />
    </g>
    <g class="wash">
      {bands.map((b, i) => <path class:list={['drift', i % 2 ? 'drift-rev' : '']} d={b.d} fill={b.fill} />)}
    </g>
    <g class="drift drift-slow" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" opacity="0.55">
      {contours.map((c) => <path d={c} />)}
    </g>
    <g fill="#ffffff">{dots.map((p) => <circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r={p.r.toFixed(2)} opacity={p.o.toFixed(2)} />)}</g>

    <!-- a rowing boat with ripples -->
    <g class="boat" transform="translate(190 120) rotate(-14)">
      <g fill="none" stroke="#ffffff" stroke-width="1.6" opacity="0.7">
        <ellipse rx="92" ry="46" /><ellipse rx="68" ry="33" /><ellipse rx="46" ry="22" opacity="0.6" />
      </g>
      <path d="M-38 0 C -26 -15, 26 -15, 40 0 C 26 15, -26 15, -38 0 Z" fill="#f2e8d6" stroke="#22302e" stroke-width="1.6" />
      <path d="M-20 0 H 22" stroke="#c8b48a" stroke-width="5" stroke-linecap="round" />
      <path d="M-6 -28 L 6 28" stroke="#22302e" stroke-width="2.4" stroke-linecap="round" />
      <path d="M-9 -34 L -3 -22 M3 22 L 9 34" stroke="#22302e" stroke-width="5" stroke-linecap="round" />
    </g>

    <!-- a beach umbrella seen from above, with its shadow -->
    <g transform="translate(1340 636) scale(0.72)">
      <ellipse cx="18" cy="12" rx="54" ry="22" fill="#c8b48a" opacity="0.35" />
      <circle r="44" fill="#ffffff" stroke="#22302e" stroke-width="1.6" />
      {[0, 45, 90, 135].map((a) => <path d={`M${(-44 * Math.cos((a * Math.PI) / 180)).toFixed(1)} ${(-44 * Math.sin((a * Math.PI) / 180)).toFixed(1)} L${(44 * Math.cos((a * Math.PI) / 180)).toFixed(1)} ${(44 * Math.sin((a * Math.PI) / 180)).toFixed(1)}`} stroke="#86c9c4" stroke-width="1.6" />)}
      <path d="M0 -44 A 44 44 0 0 1 31.1 -31.1 L0 0 Z M44 0 A 44 44 0 0 1 31.1 31.1 L0 0 Z M0 44 A 44 44 0 0 1 -31.1 31.1 L0 0 Z M-44 0 A 44 44 0 0 1 -31.1 -31.1 L0 0 Z" fill="#bfe3df" />
      <circle r="3.5" fill="#22302e" />
    </g>

    <!-- sparkles on the water -->
    <g fill="#ffffff" class="sparkle">{sparkles.map(([x, y, s]) => <path d={star(x, y, s)} />)}</g>
  </svg>
</div>

<style>
  /* the sea bands and contour lines drift sideways; each band is drawn twice as wide */
  .drift { animation: art-drift 80s linear infinite; }
  .drift-rev { animation-direction: reverse; animation-duration: 110s; }
  .drift-slow { animation-duration: 140s; }
  @keyframes art-drift { to { transform: translateX(-800px); } }
  /* the water breathes in and out over the sand */
  .wash { animation: art-wash 9s ease-in-out infinite alternate; }
  @keyframes art-wash { from { transform: translateY(-6px); } to { transform: translateY(8px); } }
  .boat { animation: art-bob 6s ease-in-out infinite alternate; transform-box: fill-box; }
  @keyframes art-bob { to { translate: 0 6px; } }
  .sparkle { animation: art-twinkle 3.2s ease-in-out infinite alternate; }
  @keyframes art-twinkle { from { opacity: 0.35; } to { opacity: 1; } }
  .beach-art.is-off :is(.drift, .wash, .boat, .sparkle) { animation-play-state: paused; }
  :global(.reduced) .beach-art :is(.drift, .wash, .boat, .sparkle) { animation: none; }
  @media (prefers-reduced-motion: reduce) { .beach-art :is(.drift, .wash, .boat, .sparkle) { animation: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-beach-art]').forEach((el) => {
    new IntersectionObserver(([e]) => el.classList.toggle('is-off', !e.isIntersecting)).observe(el);
  });
</script>
