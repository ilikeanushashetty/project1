---
/**
 * An animated aerial shoreline to sit behind frosted glass: clear turquoise sea
 * fading into wet sand, with white foam waves washing in and out and drifting
 * sideways. Fills its positioned parent; decorative only. Waves move with CSS
 * transforms, pause off-screen and stay still for reduced motion.
 * (The same sea as the original "What Awaits You" section.)
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;

const W = 3200, P = 1600, H = 640; // svg width, wave period (seamless drift), viewBox height
let seed = 7;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const edge = (y0: number, amp: number) => {
  const h = [1, 3, 5, 9].map((k, j) => ({ k, a: amp * [1, 0.5, 0.3, 0.16][j] * (0.7 + rnd() * 0.6), p: rnd() * Math.PI * 2 }));
  const pts: [number, number][] = [];
  for (let x = 0; x <= W; x += 20) pts.push([x, y0 + h.reduce((s, { k, a, p }) => s + a * Math.sin((2 * Math.PI * k * x) / P + p), 0)]);
  return pts;
};
const d = (pts: [number, number][]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y.toFixed(1)}`).join(' ');

/* foam waves: leading edge (towards the shore) at y, sheet depth, wash timing */
const waves = [
  { y: 150, depth: 80, op: 0.55, drift: 140, wash: 9 },
  { y: 270, depth: 95, op: 0.65, drift: 110, wash: 8 },
  { y: 390, depth: 110, op: 0.75, drift: 160, wash: 10 },
  { y: 500, depth: 120, op: 0.85, drift: 125, wash: 7.5 },
].map((w) => {
  const lead = edge(w.y, 26);
  const back = edge(w.y - w.depth, 14);
  return { ...w, line: d(lead), sheet: `${d(back)} L${[...lead].reverse().map(([x, y]) => `${x} ${y.toFixed(1)}`).join(' L')}Z` };
});
const swashLead = edge(590, 12);
const swash = `M0 ${H + 20} L${swashLead.map(([x, y]) => `${x} ${y.toFixed(1)}`).join(' L')} L${W} ${H + 20}Z`;
---

<div class:list={['shore pointer-events-none absolute inset-0 overflow-hidden', cls]} aria-hidden="true" data-shore>
  {waves.map((w, i) => (
    <div class="foam" style={`--wash:${w.wash}s;--delay:${-i * 1.7}s`}>
      <svg class:list={['foam-svg', i % 2 && 'rev']} style={`--drift:${w.drift}s`} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
        <defs>
          <linearGradient id={`sg${i}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fff" stop-opacity="0" />
            <stop offset="1" stop-color="#fff" stop-opacity={w.op} />
          </linearGradient>
        </defs>
        <path d={w.sheet} fill={`url(#sg${i})`} />
        <path d={w.line} fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" opacity="0.95" />
      </svg>
    </div>
  ))}
  <div class="foam" style="--wash:6.5s;--delay:-2s">
    <svg class="foam-svg" style="--drift:200s" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
      <path d={swash} fill="rgb(255 255 255 / 0.35)" />
      <path d={d(swashLead)} fill="none" stroke="#fff" stroke-width="2" opacity="0.8" />
    </svg>
  </div>
</div>

<style>
  /* aerial shoreline: clear shallow sea fading into wet sand */
  .shore { background: linear-gradient(180deg, #86c9c4 0%, #a6d9d3 28%, #cfeae5 56%, #ece6d6 80%, #f2e8d6 100%); }
  /* each wave washes in and out (vertical) while drifting sideways (horizontal) */
  .foam { position: absolute; inset: 0; animation: wash var(--wash) ease-in-out var(--delay) infinite alternate; will-change: transform; }
  .foam-svg { position: absolute; top: 0; left: 0; width: 3200px; height: 100%; animation: drift var(--drift) linear infinite; will-change: transform; }
  .foam-svg.rev { animation-direction: reverse; }
  @keyframes wash { from { transform: translateY(-3.5%); } to { transform: translateY(3%); } }
  @keyframes drift { to { transform: translateX(-1600px); } }
  .shore.is-off :is(.foam, .foam-svg) { animation-play-state: paused; }
  :global(.reduced) .shore :is(.foam, .foam-svg) { animation: none; }
  @media (prefers-reduced-motion: reduce) { .foam, .foam-svg { animation: none; } }
</style>

<script>
  // pause the waves while they are off-screen
  document.querySelectorAll<HTMLElement>('[data-shore]').forEach((el) => {
    new IntersectionObserver(([e]) => el.classList.toggle('is-off', !e.isIntersecting)).observe(el);
  });
</script>
