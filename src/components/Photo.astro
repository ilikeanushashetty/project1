---
/** Optimised responsive photo: AVIF + WebP, lazy by default, optional wipe reveal. */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  class?: string;
  imgClass?: string;
  reveal?: boolean;
  priority?: boolean;
  widths?: number[];
}
const {
  src, alt, sizes = '(min-width: 1024px) 50vw, 100vw', class: cls = '', imgClass = '',
  reveal = false, priority = false, widths = [480, 768, 1080, 1440, 1920],
} = Astro.props;
const usable = widths.filter((w) => w <= src.width).concat(src.width < Math.max(...widths) ? [src.width] : []);
---

<div class:list={['relative overflow-hidden', reveal && 'reveal-img', cls]}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[...new Set(usable)]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
    class:list={['h-full w-full object-cover', imgClass]}
  />
</div>
