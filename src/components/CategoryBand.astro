---
/**
 * Short text beside a row of tall, labelled photo tiles (one tap to the detail).
 * A tile without a photo shows a calm placeholder (icon + label) until real photos arrive.
 * Phones: text first, then tiles in a swipeable row.
 */
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';

interface Tile { label: string; icon: string; image?: ImageMetadata; href: string; focus?: string }
interface Props {
  id?: string;
  eyebrow?: string; // section name, not shown
  title: string;                 // may contain <em>
  text: string;
  tiles: Tile[];
  cta?: { label: string; href: string; book?: string };
  reverse?: boolean;
  tone?: 'shell' | 'champagne';
}
const { id, title, text, tiles, cta, reverse = false, tone = 'shell' } = Astro.props;
---

<section id={id} class:list={['band scroll-mt-28 py-[clamp(3rem,6vw,5rem)]', tone === 'champagne' && 'bg-champagne']}>
  <div class="container-x grid items-center gap-8 lg:grid-cols-12 lg:gap-12">
    <div class:list={['lg:col-span-4', reverse && 'lg:order-2 lg:col-start-9']}>
      <h2 data-split set:html={title} />
      <p class="mt-4 max-w-md leading-relaxed text-ink/75" data-fade>{text}</p>
      {cta && (
        <a href={cta.href} data-book={cta.book} class="btn btn-fill mt-7" data-fade>{cta.label} <Icon name="arrow" class="size-4" /></a>
      )}
    </div>
    <ul class:list={['tiles lg:col-span-8', reverse && 'lg:order-1']} style={`--n:${tiles.length}`} data-stagger>
      {tiles.map((t) => (
        <li data-fade>
          <a href={t.href} class="tile group">
            {t.image ? (
              <Photo src={t.image} alt={t.label} sizes="(min-width:1024px) 22vw, 70vw" class="h-full" imgClass={t.focus} />
            ) : (
              <span class="tile-ph" aria-hidden="true"><Icon name={t.icon} class="size-10" /><span class="mt-3 text-[0.7rem] font-semibold tracking-[0.14em] uppercase opacity-70">Photo coming soon</span></span>
            )}
            <span class="tile-label"><span>{t.label}</span><Icon name="arrow" class="size-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100" /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tiles { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 0.6rem; }
  @media (max-width: 1023px) {
    /* swipeable row */
    .tiles { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: min(70vw, 280px); overflow-x: auto; scroll-snap-type: x mandatory; --gutter: clamp(1.25rem, 4vw, 3.5rem); margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); scrollbar-width: none; }
    .tiles > li { scroll-snap-align: start; }
  }
  .tile { position: relative; display: block; aspect-ratio: 3 / 4; overflow: hidden; background: var(--color-ocean-deep); }
  .tile :global(img) { transition: transform 1.2s var(--ease-out-expo); }
  .tile:hover :global(img) { transform: scale(1.06); }
  .tile-ph { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: rgb(22 32 38 / 0.7);
    background: linear-gradient(160deg, #c2d5d3, #a0c1bd 55%, #86b1af); }
  .tile-label { position: absolute; inset: auto 0 0 0; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 3rem 1.1rem 1rem; color: #fff;
    background: linear-gradient(transparent, rgb(22 32 38 / 0.8)); font-family: var(--font-display); font-size: 1.3rem; line-height: 1.15; }
  .tile:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 3px; }
</style>
