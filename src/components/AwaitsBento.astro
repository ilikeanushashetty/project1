---
/**
 * "What Awaits You", Apple style: a big centred headline, a sentence that
 * lights up word by word as you scroll (motion.ts data-words), and a minimal
 * bento grid whose tiles rise in one after another (distances count up via
 * motion.ts data-count). The large beach tile keeps
 * the original shoreline colours. Everything is static for reduced motion.
 */
import Icon from './Icon.astro';
import WaveEdge from './WaveEdge.astro';

interface Item { title: string; icon: string; text?: string }
interface Props { items: Item[]; /** section name, not shown */ eyebrow?: string; title: string; text: string; cta: { label: string; href: string; book?: string }; link?: { label: string; href: string } }
const { items, title, text, cta, link } = Astro.props;

// the four headline features get their own tiles; the rest fill the small grid
const pick = (t: string) => items.find((i) => i.title === t)!;
const beach = pick('Walk to the beach');
const blueFlag = pick('Blue Flag Beach');
const surf = pick('Surfing');
const delta = pick('Backwater meets sea');
const rest = items.filter((i) => ![beach, blueFlag, surf, delta].includes(i));
---

<div class="awaits py-[clamp(4.5rem,9vw,8rem)]" data-awaits>
  <div class="container-x">
    <!-- headline -->
    <div class="mx-auto max-w-[56rem] text-center">
      <!-- one line at every width: the type scales with the screen instead of wrapping -->
      <h2 class="text-[clamp(1.15rem,5.9vw,3rem)] whitespace-nowrap" data-split set:html={title} />
      <p class="aw-lead mx-auto mt-6 max-w-[52rem] text-[clamp(1.1rem,1.6vw,1.4rem)] leading-[1.55] text-ink" data-words>{text}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-x-8 gap-y-4" data-fade>
        <a href={cta.href} data-book={cta.book} class="btn btn-fill">{cta.label} <Icon name="arrow" class="size-4" /></a>
        {link && <a href={link.href} class="link-u inline-flex items-center gap-2 py-3 text-[0.95rem] font-medium text-sea">{link.label} <Icon name="arrow" class="size-4" /></a>}
      </div>
    </div>

    <!-- bento grid -->
    <ul class="mx-auto mt-[clamp(2.5rem,5vw,4rem)] grid max-w-[68rem] grid-cols-2 gap-3 lg:grid-cols-4">
      <li class="tile tile-beach col-span-2 lg:row-span-2" style="--i:0">
        <Icon name={beach.icon} class="size-6 text-ink/80" />
        <div class="relative z-[1] mt-auto pt-8">
          <p class="stat text-[clamp(2.8rem,5vw,4.4rem)]"><span data-count="2">2</span> min</p>
          <h3 class="mt-2">{beach.title}</h3>
          <p class="mt-1 text-[0.92rem] text-ink/70">{beach.text}</p>
        </div>
        <WaveEdge fill="rgb(255 255 255 / 0.55)" />
      </li>
      <li class="tile bg-sand" style="--i:1">
        <Icon name={blueFlag.icon} class="size-6 text-sea" />
        <p class="stat mt-auto pt-6 text-[clamp(2rem,3vw,2.6rem)] text-sea"><span data-count="3">3</span> km</p>
        <h3 class="mt-1.5">{blueFlag.title}</h3>
      </li>
      <li class="tile bg-mist" style="--i:2">
        <Icon name={surf.icon} class="size-6 text-sea" />
        <p class="stat mt-auto pt-6 text-[clamp(2rem,3vw,2.6rem)] text-sea"><span data-count="200">200</span> m</p>
        <h3 class="mt-1.5">Surf Club</h3>
      </li>
      <li class="tile tile-delta col-span-2" style="--i:3">
        <Icon name={delta.icon} class="size-6 text-turquoise" />
        <div class="mt-auto pt-6">
          <h3 class="text-white">{delta.title}</h3>
          <p class="mt-1 text-[0.92rem] text-white/80">{delta.text}</p>
        </div>
      </li>
      {rest.map((it, n) => (
        <li class="tile tile-sm" style={`--i:${(n % 4) + 1}`}>
          <Icon name={it.icon} class="size-6 text-sea" />
          <h3 class="mt-auto pt-6">{it.title}</h3>
          {it.text && <p class="mt-1 text-[0.86rem] leading-snug text-ink-muted">{it.text}</p>}
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* tiles: soft rounded panels, no borders (Apple-like) */
  .tile { position: relative; display: flex; min-height: 9.5rem; flex-direction: column; overflow: hidden; border-radius: 20px; padding: clamp(1.1rem, 1.7vw, 1.6rem); color: var(--color-ink); }
  .tile-sm { min-height: 8.5rem; background: #f4f7f6; }
  .tile-beach { min-height: 19rem; background: linear-gradient(165deg, #86c9c4 0%, #a6d9d3 35%, #cfeae5 68%, #f2e8d6 100%); }
  .tile-delta { background: var(--color-sea); }
  .stat { font-family: var(--font-display); font-weight: 400; line-height: 0.95; letter-spacing: -0.01em; }
  .stat span { font-variant-numeric: tabular-nums; }
  @media (max-width: 639px) { .tile { min-height: 8.5rem; border-radius: 16px; } .tile-beach { min-height: 15rem; } }

  /* the split words are inline-blocks; drop the descender room headlines need so lines stay even */
  .aw-lead :global(.split-line) { padding-bottom: 0; margin-bottom: 0; vertical-align: top; }

  /* tiles rise, sharpen and settle, one after another */
  :global(.js:not(.reduced)) .tile { opacity: 0; transform: translateY(48px) scale(0.96); filter: blur(6px);
    transition: opacity 0.9s ease, transform 1.2s var(--ease-out-expo), filter 0.9s ease; transition-delay: calc(var(--i) * 0.09s); }
  :global(.js:not(.reduced)) .tile.is-in { opacity: 1; transform: none; filter: none; }
  .tile:hover { transform: translateY(-4px) !important; transition-delay: 0s !important; }
  @media (hover: none) { .tile:hover { transform: none !important; } }
</style>

<script>
  // tiles rise in the first time they scroll into view
  const root = document.querySelector<HTMLElement>('[data-awaits]');
  if (root) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: 0.2 });
    root.querySelectorAll('.tile').forEach((t) => io.observe(t));
  }
</script>
