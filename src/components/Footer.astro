---
import { Image } from 'astro:assets';
import { nav, site, img } from '@/data/site';
import PaperEdge from './PaperEdge.astro';
import Botanical from './Botanical.astro';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---

<footer class="relative z-[1] overflow-x-clip bg-night pt-[clamp(6rem,12vw,10rem)] text-paper/80">
  <!-- torn edge sits on top of whatever section comes before the footer -->
  <PaperEdge fill="var(--color-night)" variant={2} class="!bottom-auto top-px -translate-y-full" />
  <Botanical class="pointer-events-none absolute -right-10 bottom-0 w-[260px] text-paper/10 md:w-[360px]" />

  <div class="container-x relative">
    <div class="grid gap-14 border-b border-paper/10 pb-16 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="font-display text-[clamp(2.4rem,5vw,4rem)] leading-none text-paper" data-split>
          Rooted in <em class="text-lime">earth</em>, where the river meets the <em class="text-mist">sea</em>.
        </p>
        <a href="/contact#book" class="btn btn-line mt-10 text-paper" data-fade>Plan your stay <Icon name="arrow" class="size-4" /></a>
      </div>

      <div class="md:col-span-2 md:col-start-7">
        <p class="eyebrow mb-5 text-sun">Explore</p>
        <ul class="space-y-3 text-sm">
          <li><a href="/" class="link-u">Home</a></li>
          {nav.map((l) => <li><a href={l.href} class="link-u">{l.label}</a></li>)}
        </ul>
      </div>

      <div class="md:col-span-4">
        <p class="eyebrow mb-5 text-sun">Visit</p>
        <address class="space-y-4 text-sm not-italic leading-relaxed">
          <a href={site.mapsUrl} target="_blank" rel="noopener" class="flex gap-3 hover:text-paper"><Icon name="pin" class="mt-0.5 size-4 shrink-0" /><span>{site.address.join(', ')}</span></a>
          <a href={site.phoneHref} class="flex gap-3 hover:text-paper"><Icon name="phone" class="mt-0.5 size-4 shrink-0" />{site.phone}</a>
          <a href={site.phoneAltHref} class="flex gap-3 hover:text-paper"><Icon name="phone" class="mt-0.5 size-4 shrink-0" />{site.phoneAlt}</a>
          <a href={`mailto:${site.email}`} class="flex gap-3 break-all hover:text-paper"><Icon name="mail" class="mt-0.5 size-4 shrink-0" />{site.email}</a>
        </address>
      </div>
    </div>

    <div class="flex flex-col items-start justify-between gap-6 py-8 text-xs text-paper/50 md:flex-row md:items-center">
      <div class="flex items-center gap-4">
        <Image src={img.logoLight} alt="Tierra Resort & Villas logo" widths={[120, 240]} sizes="120px" class="h-16 w-auto" />
        <span>© {year} {site.fullName}. All rights reserved.</span>
      </div>
      <div class="flex items-center gap-5">
        <span>Check-in {site.checkIn} · Check-out {site.checkOut}</span>
        <a href={site.instagram} aria-label="Instagram" class="hover:text-paper"><Icon name="instagram" class="size-5" /></a>
        <a href={site.facebook} aria-label="Facebook" class="hover:text-paper"><Icon name="facebook" class="size-5" /></a>
      </div>
    </div>
  </div>
</footer>
