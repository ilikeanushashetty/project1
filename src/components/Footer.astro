---
import { Image } from 'astro:assets';
import { site, img, waLink, footerLinks } from '@/data/site';
import Botanical from './Botanical.astro';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
// social links without a real address yet ('#') are left out
const socials = [
  { label: 'WhatsApp', icon: 'whatsapp', href: waLink(), external: true },
  { label: 'Facebook', icon: 'facebook', href: site.facebook, external: true },
  { label: 'Instagram', icon: 'instagram', href: site.instagram, external: true },
  { label: `Call ${site.phone}`, icon: 'phone', href: site.phoneHref },
  { label: `Email ${site.email}`, icon: 'mail', href: `mailto:${site.email}` },
].filter((s) => s.href !== '#');
---

<!-- white, compact, ink type -->
<footer class="relative z-[1] overflow-hidden border-t border-ink/10 bg-white pt-[clamp(2rem,4vw,3rem)] text-ink">
  <Botanical class="pointer-events-none absolute -right-10 bottom-0 w-[200px] text-ink/[0.07] md:w-[280px]" />

  <div class="container-x relative">
    <!-- one horizontal row: logo · contact icons · address (stacks on phones) -->
    <div class="flex flex-col items-center gap-6 border-b border-ink/10 pb-7 text-center lg:flex-row lg:justify-between lg:gap-10 lg:text-left">
      <Image src={img.logo} alt={site.fullName} widths={[180, 360]} sizes="180px" class="h-16 w-auto shrink-0" />
      <ul class="flex flex-wrap justify-center gap-3">
        {socials.map((s) => (
          <li>
            <a href={s.href} aria-label={s.label} target={s.external ? '_blank' : undefined} rel={s.external ? 'noopener' : undefined}
              class="grid size-11 place-items-center border border-ink/30 text-ink transition-colors duration-300 hover:border-sea hover:bg-sea hover:text-white">
              <Icon name={s.icon} class="size-[1.15rem]" />
            </a>
          </li>
        ))}
      </ul>
      <address class="text-sm not-italic leading-relaxed text-ink/85 lg:whitespace-nowrap">
        <a href={site.mapsUrl} target="_blank" rel="noopener" class="hover:text-teal">{site.address[0]} {site.address[1]}</a>
        <span class="mx-2 hidden text-ink/40 sm:inline" aria-hidden="true">·</span>
        <a href={site.phoneHref} class="mt-1 block font-semibold whitespace-nowrap text-ink hover:text-teal sm:mt-0 sm:inline">{site.phone}</a>
      </address>
    </div>

    <!-- page links, so the bottom of every page leads somewhere -->
    <nav aria-label="Footer" class="border-b border-ink/10 py-2">
      <ul class="flex flex-wrap justify-center gap-x-1 gap-y-1 text-[0.8rem] font-semibold tracking-[0.1em] text-ink uppercase">
        {footerLinks.map((l) => <li><a href={l.href} class="inline-block px-3 py-3 md:py-2.5 transition-colors hover:text-teal">{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="flex flex-col items-center justify-between gap-1 py-3 text-[0.8rem] text-ink/80 md:flex-row">
      <span>© {year} {site.name}. All Rights Reserved.</span>
      <!-- Terms of Service: add once the resort provides its booking terms -->
      <a href="/privacy" class="inline-block py-2.5 hover:text-teal">Privacy Policy</a>
    </div>
  </div>
</footer>
