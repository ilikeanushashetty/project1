---
/**
 * A photo seen through a torn opening in sculpted plaster.
 * The plaster is a pre-rendered transparent image (plaster-portal.png,
 * 1600x2000, opening centred at 800,960 with radii 420x590), so the page only
 * animates cheap transforms: the photo drifts inside the opening on scroll.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import plaster from '@/assets/images/plaster-portal.png';
import Photo from './Photo.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}
const { src, alt, class: cls = '' } = Astro.props;

// window behind the opening (opening + 70px margin, as % of the 1600x2000 frame)
const win = { left: (310 / 1600) * 100, top: (300 / 2000) * 100, width: (980 / 1600) * 100, height: (1320 / 2000) * 100 };
---

<div data-portal class:list={['relative aspect-[4/5] w-full', cls]}>
  <div class="absolute overflow-hidden [clip-path:ellipse(50%_50%_at_50%_50%)]"
       style={`left:${win.left}%;top:${win.top}%;width:${win.width}%;height:${win.height}%`}>
    <div data-portal-photo class="absolute -inset-[10%] will-change-transform">
      <Photo src={src} alt={alt} sizes="(min-width:1024px) 34vw, 70vw" class="h-full" />
    </div>
  </div>
  <div data-portal-plaster class="pointer-events-none absolute inset-0 will-change-transform">
    <Picture src={plaster} alt="" formats={['avif', 'webp']} widths={[600, 900, 1200, 1600]}
      sizes="(min-width:1024px) 50vw, 100vw" class="h-full w-full" loading="lazy" decoding="async" />
  </div>
</div>
